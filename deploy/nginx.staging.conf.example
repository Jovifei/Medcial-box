# Integrate into the existing proxy only after confirming the hostname,
# certificate paths and loopback port. This is not an installed configuration.
server {
    listen 80;
    server_name medbox-test.example.invalid;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name medbox-test.example.invalid;
    ssl_certificate /etc/letsencrypt/live/medbox-test.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/medbox-test.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # The largest authenticated photo route accepts an 8 MiB decoded image in
    # base64 JSON (Fastify bodyLimit 12 MiB). Keep the reverse-proxy envelope
    # aligned so valid mobile uploads are not rejected with 413 before the API.
    client_max_body_size 12m;

    location /api/ {
        proxy_pass http://127.0.0.1:3301;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The API's login limiter trusts these headers only because this proxy
        # overwrites them and the API remains bound to the loopback interface.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        # Local vision recognition may legitimately run for up to 55 seconds;
        # clients allow 70 seconds. Keep Nginx above provider processing and
        # normal network jitter so it does not manufacture an early 504.
        proxy_read_timeout 75s;
        add_header X-Content-Type-Options nosniff always;
    }
    location / { return 404; }
}
