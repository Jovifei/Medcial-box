# Copy to deploy/.env.staging on the target server; chmod 600.
# Required private values are intentionally empty.
POSTGRES_DB=medbox_staging
POSTGRES_USER=medbox_staging
POSTGRES_PASSWORD=
STAGING_API_PORT=3301
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional until photo recognition is enabled. Keep this server-side only.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3-vl-flash

# Optional features remain unavailable until these providers are configured.
JISU_MEDICINE_API_KEY=
WECHAT_REMINDER_TEMPLATE_ID=
WECHAT_REMINDER_FIELD_MAP=
WECHAT_REMINDER_SCHEDULER_ENABLED=false
# 服药提醒（R4）：模板在药箱专用 AppID 的mp后台「订阅消息」里申请；
# 没配置时服药提醒不可用，计划与今日安排不受影响。
WECHAT_DOSE_REMINDER_TEMPLATE_ID=
WECHAT_DOSE_REMINDER_FIELD_MAP=
WECHAT_DOSE_REMINDER_SCHEDULER_ENABLED=false
WECHAT_MINIPROGRAM_STATE=trial
