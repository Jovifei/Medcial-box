# Template only. Run `npm run setup:staging` to create deploy/.env.staging.
# The setup command manages the first three values and preserves all other existing lines.
POSTGRES_PASSWORD=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Optional provider settings. Leave disabled/blank until that capability is intentionally enabled.
MEDICINE_RECOGNITION_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3-vl-flash
# For host-local Ollama staging, set provider=ollama and confirm host.docker.internal is reachable.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:0.8b
JISU_MEDICINE_API_KEY=

# WeChat reminders remain off until approved templates and field maps are configured.
WECHAT_REMINDER_TEMPLATE_ID=
WECHAT_REMINDER_FIELD_MAP=
WECHAT_REMINDER_SCHEDULER_ENABLED=false
WECHAT_DOSE_REMINDER_TEMPLATE_ID=
WECHAT_DOSE_REMINDER_FIELD_MAP=
WECHAT_DOSE_REMINDER_SCHEDULER_ENABLED=false
WECHAT_MINIPROGRAM_STATE=trial

STAGING_API_PORT=3301
