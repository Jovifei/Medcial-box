.business-nav-wrapper {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: block;
  width: 100%;
  background: #ffffff;
  border-top: 1rpx solid #e5e5e5;
  box-sizing: border-box;
}

.business-nav-spacer { height: calc(200rpx + env(safe-area-inset-bottom)); }
.business-nav-wrapper.embedded { position: static; }

.business-nav-bar {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: space-around;
  align-items: center;
  min-height: 96rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  box-sizing: content-box;
}

.business-nav-tab {
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-width: 0;
  min-height: 96rpx;
  margin: 0;
  padding: 16rpx 4rpx;
  border-radius: 0;
  background: transparent;
  line-height: 1.4;
  text-align: center;
  box-sizing: border-box;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}

.business-nav-tab::after { border: 0; }

.business-nav-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #758278;
  letter-spacing: 0.5rpx;
  transition: color 0.15s ease;
}

.business-nav-tab.active .business-nav-text {
  color: #3f7d5c;
  font-weight: 600;
}
