/* 全局共享样式：卡片、表单、按钮、状态徽标。
   设计规范：
   - 视线统一：列表、表单、卡片主要信息强左对齐；空状态、弹窗与底部动作按钮视觉居中
   - 标准 4 阶字阶：标题 36rpx、正文/输入 30rpx、次要说明 26rpx、辅助标签 22rpx
   - 8rpx 网格：卡片圆角 24rpx，控件圆角 16rpx，标准间距 16rpx / 24rpx / 32rpx
*/
page {
  background: #f8fafc;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

.card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
  box-sizing: border-box;
}

.section-title {
  margin: 0 0 16rpx;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.4;
  color: #0f172a;
  text-align: left;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: left;
}

.field-hint {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: left;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 30rpx;
  line-height: 1.45;
  color: #0f172a;
  text-align: left;
}

.textarea {
  height: 160rpx;
}

.picker-box {
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 16rpx;
  background: #ffffff;
  color: #0f172a;
  font-size: 30rpx;
  line-height: 1.45;
  text-align: left;
}

.btn {
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 650;
  text-align: center;
  line-height: 1.35;
}

.btn-primary {
  background: #047857;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(4, 120, 87, 0.2);
}

.btn-ghost {
  border: 1rpx solid #cbd5e1;
  background: #fff;
  color: #047857;
}

.btn-danger {
  border: 1rpx solid #fecaca;
  background: #fef2f2;
  color: #b91c1c;
}

.btn[disabled] {
  opacity: 0.55;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.badge-expired {
  background: #fee2e2;
  color: #991b1b;
}

.badge-due {
  background: #fef3c7;
  color: #92400e;
}

.badge-soon {
  background: #fef3c7;
  color: #92400e;
}

.badge-ok {
  background: #ecfdf5;
  color: #065f46;
}

.badge-unknown {
  background: #f1f5f9;
  color: #475569;
}

.hint {
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: left;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
