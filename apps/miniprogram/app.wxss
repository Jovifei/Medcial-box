/* 全局共享样式：卡片、表单、按钮、状态徽标。
   设计规范：
   - 视线统一：列表、表单、卡片主要信息强左对齐；空状态、弹窗与底部动作按钮视觉居中
   - 标准 4 阶字阶：标题 36rpx、正文/输入 30rpx、次要说明 26rpx、辅助标签 22rpx
   - 8rpx 网格：卡片圆角 24rpx，控件圆角 16rpx，标准间距 16rpx / 24rpx / 32rpx
*/
/* Apple 分组列表语义色。每个 var 同时保留字面 fallback，供独立组件使用。
   品牌绿只用于动作/选中态；危险与待核对必须同时有文字说明。 */
page {
  --med-background: #f2f2f7;
  --med-surface: #ffffff;
  --med-inset: #f2f2f7;
  --med-label: #1c1c1e;
  --med-secondary: #636366;
  --med-line: #dcdce1;
  --med-accent: #087f5b;
  --med-accent-tint: #edf6f2;
  --med-success: #146c43;
  --med-success-tint: #e9f6ee;
  --med-warning: #8a5700;
  --med-warning-tint: #fff4de;
  --med-danger: #b42318;
  --med-danger-tint: #fff0ee;
  --med-danger-line: #efc8c3;
  background: var(--med-background, #f2f2f7);
  color: var(--med-label, #1c1c1e);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 15px;
  line-height: 1.5;
}

.page { padding: 16px; box-sizing: border-box; }

.card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 0;
  border-radius: 12px;
  background: #ffffff;
  box-shadow: none;
  box-sizing: border-box;
}

.section-title {
  margin: 0 0 16rpx;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.4;
  color: var(--med-label, #1c1c1e);
  text-align: left;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: var(--med-label, #1c1c1e);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: left;
}

.field-hint {
  margin-top: 8rpx;
  color: var(--med-secondary, #636366);
  font-size: 26rpx;
  line-height: 1.5;
  text-align: left;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 48px;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--med-line, #dcdce1);
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 30rpx;
  line-height: 1.45;
  color: var(--med-label, #1c1c1e);
  text-align: left;
}

.textarea {
  height: 160rpx;
}

.picker-box {
  min-height: 48px;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--med-line, #dcdce1);
  border-radius: 16rpx;
  background: #ffffff;
  color: var(--med-label, #1c1c1e);
  font-size: 30rpx;
  line-height: 1.45;
  text-align: left;
}

.btn {
  min-height: 48px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 650;
  text-align: center;
  line-height: 1.35;
}

.btn-primary {
  background: var(--med-accent, #087f5b);
  color: #fff;
  box-shadow: none;
}

.btn-ghost {
  border: 1rpx solid var(--med-line, #dcdce1);
  background: #fff;
  color: var(--med-accent, #087f5b);
}

.btn-danger {
  border: 1rpx solid var(--med-danger-line, #efc8c3);
  background: var(--med-danger-tint, #fff0ee);
  color: var(--med-danger, #b42318);
}

.btn[disabled] {
  opacity: 0.55;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.badge-expired {
  background: var(--med-danger-tint, #fff0ee);
  color: var(--med-danger, #b42318);
}

.badge-due {
  background: var(--med-warning-tint, #fff4de);
  color: var(--med-warning, #8a5700);
}

.badge-soon {
  background: var(--med-warning-tint, #fff4de);
  color: var(--med-warning, #8a5700);
}

.badge-ok {
  background: var(--med-success-tint, #e9f6ee);
  color: var(--med-success, #146c43);
}

.badge-unknown {
  background: var(--med-inset, #f2f2f7);
  color: var(--med-secondary, #636366);
}

.hint {
  color: var(--med-secondary, #636366);
  font-size: 26rpx;
  line-height: 1.5;
  text-align: left;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 微信窄屏仍保证逻辑像素触控尺寸；局部组件通过同语义类复用。 */
.btn, .link-btn, .inline-action { min-width: 48px; min-height: 48px; box-sizing: border-box; }
.inline-action { display: flex; align-items: center; justify-content: center; padding: 0 8px; color: var(--med-accent, #087f5b); font-size: 13px; flex: none; }
.btn::after { border: 0; }
.btn, .input, .textarea, .picker-box { overflow-wrap: anywhere; }
