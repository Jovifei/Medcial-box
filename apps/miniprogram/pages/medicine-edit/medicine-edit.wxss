.custom-nav {
  position: fixed;
  z-index: 80;
  top: 0; left: 0; right: 0;
  box-sizing: border-box;
  background: #f5f7f4;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-back,
.nav-placeholder {
  width: 96rpx;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back {
  color: #26372e;
  font-size: 56rpx;
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.edit-loading-mask {
  position: fixed;
  z-index: 90;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background: rgba(245, 247, 244, 0.92);
}

.edit-loading-card { width: 100%; max-width: 620rpx; }

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(120rpx + env(safe-area-inset-bottom));
}

.draft-card {
  border-color: #d7e5d9;
  background: #f7fbf7;
}

.draft-actions {
  display: flex;
  gap: 14rpx;
}

.draft-actions .btn { flex: 1; }

.barcode-info {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #d7e5d9;
  border-radius: 14rpx;
  background: #f7fbf7;
}

.barcode-label { color: #52685c; font-size: 22rpx; font-weight: 650; }
.barcode-value { margin-top: 6rpx; color: #24352c; font-size: 25rpx; word-break: break-all; }
.retry-barcode { min-height: 70rpx; font-size: 23rpx; }

.leave-mask {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(20, 30, 24, 0.42);
}

.leave-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 30rpx 32rpx calc(26rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
}

.leave-title { font-size: 30rpx; font-weight: 700; }

.batch-block {
  margin-top: 20rpx;
  padding: 22rpx 20rpx 6rpx;
  border: 1rpx solid #e9ede8;
  border-radius: 16rpx;
  background: #fbfcfb;
}

.batch-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.batch-title {
  font-size: 27rpx;
  line-height: 1.4;
  font-weight: 650;
  color: #52685c;
}

.batch-remove {
  color: #a45437;
  font-size: 23rpx;
}

.btn-ghost-mini {
  padding: 10rpx 20rpx;
  border: 1rpx solid #c8d4ca;
  border-radius: 999rpx;
  color: #3f7d5c;
  font-size: 22rpx;
  font-weight: 600;
}

.footnote {
  margin-top: 20rpx;
  padding: 0 6rpx;
}

.disabled {
  opacity: 0.6;
}

.photo-action,
.save-action {
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.35;
}

.photo-actions {
  display: flex;
  gap: 14rpx;
}

.photo-actions .photo-action {
  flex: 1;
}

.scan-action {
  min-height: 80rpx;
}

.candidate-card {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #d7e5d9;
  border-radius: 16rpx;
  background: #f6fbf7;
}

.candidate-title { font-size: 26rpx; font-weight: 700; }
.candidate-line { margin-top: 8rpx; color: #52685c; font-size: 21rpx; line-height: 1.5; }
.candidate-warning { margin-top: 10rpx; color: #8e6236; font-size: 20rpx; line-height: 1.5; }
.candidate-actions { display: flex; gap: 12rpx; margin-top: 8rpx; }
.candidate-button { flex: 1; min-height: 74rpx; margin-top: 12rpx; font-size: 23rpx; }
.opening-toggle { padding: 14rpx 0 18rpx; color: #3f7d5c; font-size: 23rpx; font-weight: 650; }

.recognition-status {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #cfe3d5;
  border-radius: 16rpx;
  background: #f2faf4;
}

.recognition-status-title {
  margin-bottom: 6rpx;
  color: #2f704f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.recognition-status-text {
  color: #496356;
  font-size: 23rpx;
  line-height: 1.6;
  word-break: break-all;
}

/* B02：人群/用途标签多选 chips */
.tag-picker {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.population-picker { grid-template-columns: repeat(2, minmax(0, 1fr)); }

.tag-chip {
  min-height: 76rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 8rpx;
  border-radius: 12rpx;
  border: 2rpx solid #cfd9d4;
  background: #f4f7f5;
  color: #496356;
  font-size: 24rpx;
  line-height: 1.4;
}

.tag-chip.selected {
  border-color: #2f7d5d;
  background: #e3f1ea;
  color: #1d5c40;
  font-weight: 600;
}

.tag-chip-purpose.selected {
  border-color: #2f7d5d;
  background: #e3f1ea;
  color: #1d5c40;
}

.save-bar { position: fixed; z-index: 85; left: 0; right: 0; bottom: 0; padding: 14rpx 28rpx calc(14rpx + env(safe-area-inset-bottom)); background: #f5f7f4; border-top: 1rpx solid #dce6dc; }
.save-bar .save-action { margin: 0; }
.quantity-row { display: flex; align-items: end; gap: 16rpx; }
.quantity-input { flex: 1; }
.quantity-unit { width: 150rpx; }

.photo-draft-row { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0; font-size: 24rpx; }
.draft-thumb { width: 90rpx; height: 90rpx; flex-shrink: 0; border-radius: 12rpx; }
.recognition-mask { position: fixed; z-index: 120; inset: 0; display: flex; align-items: center; justify-content: center; padding: 40rpx; background: rgba(22, 42, 31, .45); }
.recognition-dialog { width: 100%; max-width: 580rpx; padding: 40rpx 32rpx; box-sizing: border-box; border-radius: 28rpx; background: #fff; text-align: center; box-shadow: 0 16rpx 64rpx rgba(22, 42, 31, .16); }
.recognition-pulse { color: #3f7d5c; font-size: 76rpx; animation: recognition-pulse 1.4s ease-in-out infinite; }
.recognition-dialog-title { margin: 16rpx 0; font-size: 34rpx; font-weight: 700; }
.recognition-dialog-time { margin-bottom: 18rpx; color: #3f7d5c; font-size: 28rpx; }
@keyframes recognition-pulse { 50% { opacity: .4; } }
.leaflet-text { display: block; max-height: 520rpx; overflow-y: auto; white-space: pre-wrap; padding: 18rpx; background: #f5f8f5; border-radius: 12rpx; line-height: 1.7; font-size: 25rpx; }
