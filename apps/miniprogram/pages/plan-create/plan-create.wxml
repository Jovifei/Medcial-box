<view class="page">
  <view class="card" wx:if="{{draftAvailable}}"><view class="hint">有本账号未保存的计划草稿</view><view class="btn btn-ghost" bindtap="onRestoreDraft">恢复草稿</view></view>
  <view class="card" wx:if="{{pendingCreation}}"><view class="hint">{{creationAcknowledged ? "计划已保存" : "上次提交结果待核对"}}：{{pendingMedicineName}}。重试仅核对原提交，不保存之后的修改。</view><view class="btn btn-ghost" bindtap="onRetryPlan">{{creationAcknowledged ? "返回查看已保存计划" : "重试原提交"}}</view></view>
  <view class="card error-card" wx:if="{{errorMessage !== ''}}">
    <view class="section-title">暂时无法创建</view>
    <view class="hint">{{errorMessage}}</view>
    <view wx:if="{{!contextInvalidated}}" class="btn btn-ghost" bindtap="bootstrap">重新加载</view>
    <view wx:else class="btn btn-ghost" bindtap="navigateFromForm">返回后重新打开</view>
  </view>

  <view class="card" wx:if="{{loading}}">
    <view class="hint">正在准备创建表单…</view>
  </view>

  <block wx:if="{{!loading && errorMessage === ''}}">
    <view class="sheet-title">创建用药计划</view>
    <view class="hint sheet-hint">第一版支持固定时间安排；不做剂量推导。通知授权在保存后于“用药计划”页单独设置。</view>

    <view class="field">
      <view class="field-label">照护对象</view>
      <picker range="{{careProfiles}}" range-key="displayName" value="{{careProfileIndex}}" bindchange="onCareProfileChange">
        <view class="picker-box">{{careProfiles[careProfileIndex].displayName || "请选择"}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">药品名称（手填或从药箱选择）</view>
      <picker wx:if="{{inventoryMedicines.length > 0}}" range="{{inventoryMedicines}}" range-key="name" bindchange="onInventoryMedicineChange"><view class="picker-box">从药箱选择 ›</view></picker>
      <input class="input" value="{{medicineName}}" data-field="medicineName" bindinput="onFormInput" placeholder="例如：儿童退烧药" />
    </view>
    <view class="field">
      <view class="field-label">剂量说明</view>
      <input class="input" value="{{dosageText}}" data-field="dosageText" bindinput="onFormInput" placeholder="例如：每次 5ml，饭后" />
    </view>
    <view class="field">
      <view class="field-label">每日时间点（1-6 个）</view>
      <view class="time-add-row">
        <medicine-time-field value="{{timeInput}}" data-field="timeInput" disabled="{{creating || pendingCreation || contextInvalidated}}" bindchange="onFormDateChange" />
        <view class="action-btn primary" bindtap="onAddTimeSlot">添加</view>
      </view>
      <view class="slot-list" wx:if="{{timeSlots.length > 0}}">
        <view class="slot-chip" wx:for="{{timeSlots}}" wx:key="*this">
          <medicine-time-field value="{{item}}" data-time="{{item}}" disabled="{{creating || pendingCreation || contextInvalidated}}" bindchange="onTimeSlotChange" />
          <text class="slot-remove" data-time="{{item}}" bindtap="onRemoveTimeSlot">×</text>
        </view>
      </view>
    </view>
    <view class="field">
      <view class="row-line">
        <view class="field-label">每天</view>
        <switch checked="{{everyDay}}" bindchange="onEveryDayChange" />
      </view>
      <view class="weekday-row" wx:if="{{!everyDay}}">
        <view class="weekday-chip {{option.on ? 'on' : ''}}"
          wx:for="{{weekdayOptions}}" wx:for-item="option" wx:key="value"
          data-value="{{option.value}}" bindtap="onToggleWeekday">{{option.label}}</view>
      </view>
    </view>
    <view class="field">
      <view class="field-label">起始日期</view>
      <medicine-date-field value="{{startDate}}" data-field="startDate" label="选择开始日期" disabled="{{creating || pendingCreation || contextInvalidated}}" bindchange="onFormDateChange" />
    </view>
    <view class="field">
      <view class="field-label">结束日期（选填）</view>
      <medicine-date-field value="{{endDate}}" data-field="endDate" label="长期（可选择结束日期）" disabled="{{creating || pendingCreation || contextInvalidated}}" bindchange="onFormDateChange" />
    </view>

    <view class="btn btn-primary {{creating ? 'disabled' : ''}}" bindtap="onSubmitPlan">{{creating ? "保存中…" : "保存计划"}}</view>
    <view class="btn btn-ghost" bindtap="onCancel">取消</view>
  </block>
</view>

<view class="leave-mask" wx:if="{{leaveSheetVisible}}"><view class="leave-sheet"><view class="section-title">计划尚未保存</view><view class="btn btn-primary" bindtap="onLeaveChoice" data-choice="keep">保留草稿并返回</view><view class="btn btn-danger" bindtap="onLeaveChoice" data-choice="discard">放弃修改并返回</view><view class="btn btn-ghost" bindtap="onLeaveChoice" data-choice="continue">继续编辑</view></view></view>
