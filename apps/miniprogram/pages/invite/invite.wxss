.page {
  padding: 28rpx 30rpx 60rpx;
}

.invite-result {
  margin-top: 20rpx;
}

.invite-code {
  padding: 22rpx 20rpx;
  border: 1rpx dashed #9db8a6;
  border-radius: 14rpx;
  background: #f2f7f3;
  color: #24352c;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  word-break: break-all;
}

.invite-result .hint {
  margin-top: 10rpx;
}

.footnote {
  margin-top: 20rpx;
  padding: 0 6rpx;
}

.disabled {
  opacity: 0.6;
}

.share-btn {
  margin-top: 16rpx;
}

.share-btn::after {
  border: none;
}

.member-block {
  margin-top: 32rpx;
}

.section-title.small {
  font-size: 28rpx;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e5ece7;
}

.member-info {
  display: flex;
  flex-direction: column;
}

.member-role {
  font-size: 28rpx;
  color: #24352c;
  font-weight: 600;
}

.member-joined {
  font-size: 24rpx;
  color: #7d8a82;
}

.btn-small {
  padding: 10rpx 20rpx;
  font-size: 26rpx;
}
