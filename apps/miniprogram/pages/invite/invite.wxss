.page {
  padding: 28rpx 30rpx 60rpx;
}

.invite-result {
  margin-top: 20rpx;
}

.invite-code {
  padding: 22rpx 20rpx;
  border: 1rpx dashed #9db8a6;
  border-radius: 14rpx;
  background: var(--med-inset, #f2f2f7);
  color: var(--med-label, #1c1c1e);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  word-break: break-all;
}

.invite-result .hint {
  margin-top: 10rpx;
}

.preview {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: var(--med-inset, #f2f2f7);
}

.preview-title {
  color: var(--med-label, #1c1c1e);
  font-size: 30rpx;
  font-weight: 700;
}

.preview .hint {
  margin-top: 8rpx;
}

.preview .btn {
  margin-top: 16rpx;
}

.error {
  margin-top: 14rpx;
  color: var(--med-danger, #b42318);
  font-size: 26rpx;
  line-height: 1.5;
}

.footnote {
  margin-top: 20rpx;
  padding: 0 6rpx;
}

.disabled {
  opacity: 0.6;
}

.profile-card,
.logout-card {
  margin-top: 20rpx;
}

.share-btn {
  margin-top: 16rpx;
}

.share-btn::after {
  border: none;
}

.member-block {
  margin-top: 32rpx;
}

.section-title.small {
  font-size: 28rpx;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--med-line, #dcdce1);
}

.member-info {
  display: flex;
  flex-direction: column;
}

.member-role {
  font-size: 28rpx;
  color: var(--med-label, #1c1c1e);
  font-weight: 600;
}

.member-joined {
  font-size: 24rpx;
  color: var(--med-secondary, #636366);
}

.member-actions {
  display: flex;
  gap: 12rpx;
}

.btn-small {
  padding: 10rpx 20rpx;
  font-size: 26rpx;
}

.page { padding: 16px; }
.invite-code { font-size: 18px; padding: 16px; border: 1px solid var(--med-line, #dcdce1); border-radius: 10px; background: var(--med-inset, #f2f2f7); }
.preview { padding: 16px; border-radius: 10px; }
.preview-title { font-size: 18px; overflow-wrap: anywhere; }
.member-row, .member-actions { flex-wrap: wrap; gap: 8px; }
.btn-small { min-height: 48px; font-size: 13px; }
