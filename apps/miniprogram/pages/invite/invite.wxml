<view class="page">
  <view class="card" wx:if="{{mode === 'loading'}}">
    <view class="hint">正在确认你的家庭状态…</view>
  </view>

  <!-- owner：生成一次性邀请码 → 转发卡片 / 复制兜底；管理成员与所有权 -->
  <view class="card" wx:if="{{mode === 'owner'}}">
    <view class="section-title">邀请家人（{{familyName}}）</view>
    <view class="hint">生成一次性邀请码后，可直接"转发给微信好友"，家人点卡片即可加入；也可以复制邀请码发给他粘贴。72 小时内有效、只能使用一次。</view>
    <view class="btn btn-primary {{submitting ? 'disabled' : ''}}" bindtap="onCreateInvitation" wx:if="{{invitationCode === ''}}">
      {{submitting ? "生成中…" : "生成邀请码"}}
    </view>
    <view wx:if="{{invitationCode !== ''}}" class="invite-result">
      <view class="invite-code">{{invitationCode}}</view>
      <view class="hint">有效期至：{{invitationExpiresAt}}（一次性使用）</view>
      <button class="btn btn-primary share-btn" open-type="share">转发给微信好友</button>
      <view class="btn btn-ghost" bindtap="onCopyInvitation">复制邀请码</view>
    </view>

  </view>

  <!-- 无家庭：点卡片自动填充，或手动粘贴邀请码加入 -->
  <view class="card" wx:if="{{mode === 'join'}}">
    <view class="section-title">加入家庭</view>
    <view class="hint">家人通过微信转发邀请卡片进入本页会自动填入邀请码；也可以让管理员复制邀请码发给你，粘贴到下方。</view>
    <view class="field">
      <view class="field-label">邀请码</view>
      <input class="input" placeholder="粘贴管理员发来的邀请码" value="{{inviteInput}}" bindinput="onInviteInput" />
    </view>
    <view class="btn btn-ghost {{previewing ? 'disabled' : ''}}" bindtap="onPreviewInvitation" wx:if="{{preview === null}}">
      {{previewing ? "查询中…" : "预览邀请"}}
    </view>
    <view class="preview" wx:if="{{preview !== null}}">
      <view class="preview-title">{{preview.familyName}}</view>
      <view class="hint">有效期至：{{preview.expiresAt}}</view>
      <view class="btn btn-primary {{submitting ? 'disabled' : ''}}" bindtap="onAcceptInvitation">
        {{submitting ? "加入中…" : "确认加入"}}
      </view>
    </view>
    <view class="error" wx:if="{{errorMessage !== ''}}">{{errorMessage}}</view>
  </view>

  <!-- 普通成员：可自助退出（D3） -->
  <view class="card" wx:if="{{mode === 'member'}}">
    <view class="section-title">已在家庭（{{familyName}}）</view>
    <view class="hint">邀请与移除成员由家庭管理员管理。每个账号只属于一个家庭；退出后立即失去本药箱的访问权限，重新加入需要新的邀请（药品不会自动搬移或合并）。</view>
    <view class="btn btn-ghost" bindtap="onOpenFamily">打开我的家庭</view>
  </view>

  <view class="hint footnote">家庭共享仅同步库存管理信息；个人剂量备注默认仅本人可见，主动选择"全家可见"后其他成员只读。</view>
</view>
