.page { padding-bottom: 60rpx; }
.notice-status { margin-top: 18rpx; padding: 16rpx; border-radius: 14rpx; background: var(--med-accent-tint, #edf6f2); color: var(--med-accent, #087f5b); font-size: 22rpx; line-height: 1.55; }
.error-text { color: var(--med-danger, #b42318); }
.template-card { margin-top: 12rpx; padding: 16rpx; border: 1rpx solid #e6ebe6; border-radius: 14rpx; }
.template-title { font-size: 23rpx; font-weight: 650; }
.template-state { margin-top: 4rpx; color: var(--med-secondary, #636366); font-size: 21rpx; }
