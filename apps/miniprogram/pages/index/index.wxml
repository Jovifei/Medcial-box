<view class="page home-page">
  <view class="home-header">
    <view class="family-row">
      <view>
        <view class="family-caption">当前家庭</view>
        <view class="family-name">{{familyName || "家庭药箱"}}</view>
      </view>
      <view class="family-link" bindtap="onTapFamily">我的家庭 ›</view>
    </view>
    <view class="title">家里的药，心里有数</view>
    <view class="subtitle">管理库存、有效期与开封后的期限。</view>
  </view>

  <view class="search-box">
    <text class="search-icon">⌕</text>
    <input class="search-input" placeholder="搜索药名、成分、厂家或位置" value="{{keyword}}"
      bindinput="onSearchInput" confirm-type="search" />
    <view class="clear-search" wx:if="{{keyword !== ''}}" bindtap="onClearFilters">清除</view>
  </view>

  <scroll-view class="filter-row" scroll-x="true" show-scrollbar="false">
    <view class="filter-chip {{filterKind === 'expiring' ? 'selected' : ''}}" data-kind="expiring" bindtap="onSelectFilter">
      临期 / 过期 <text>{{expiringCount + expiredCount}}</text>
    </view>
    <view class="filter-chip {{filterKind === 'low' ? 'selected' : ''}}" data-kind="low" bindtap="onSelectFilter">
      库存不足 <text>{{lowStockCount}}</text>
    </view>
    <view class="filter-chip {{filterKind === 'missing' ? 'selected' : ''}}" data-kind="missing" bindtap="onSelectFilter">
      待补资料 <text>{{missingInfoCount}}</text>
    </view>
  </scroll-view>

  <scroll-view class="filter-row tag-filter-row" scroll-x="true" show-scrollbar="false">
    <view class="filter-chip tag-chip {{item.selected ? 'selected' : ''}}"
      wx:for="{{populationChips}}" wx:key="value"
      data-value="{{item.value}}" bindtap="onTogglePopulation">{{item.label}}</view>
    <view class="filter-chip tag-chip {{item.selected ? 'selected' : ''}}"
      wx:for="{{purposeChips}}" wx:key="value"
      data-value="{{item.value}}" bindtap="onTogglePurpose">{{item.label}}</view>
    <picker class="sort-picker" range="{{sortLabels}}" value="{{sortIndex}}" bindchange="onSortChange">
      <view class="filter-chip sort-chip">排序：{{sortLabels[sortIndex]}} ▾</view>
    </picker>
  </scroll-view>

  <view class="card error-card" wx:if="{{errorMessage !== ''}}">
    <view class="section-title">暂时无法加载药箱</view>
    <view class="hint">{{errorMessage}}</view>
    <view class="btn btn-ghost retry-btn" bindtap="onRetry">重新连接</view>
  </view>

  <view class="empty-card" wx:if="{{errorMessage === '' && allItems.length === 0}}">
    <view class="empty-mark">＋</view>
    <view class="section-title">还没有药品</view>
    <view class="hint">可以拍照识别；识别结果核对后再保存，也可以只填药名。</view>
    <view class="btn btn-primary" bindtap="onTapAdd">录入第一种药</view>
  </view>
  <view class="empty-card" wx:elif="{{errorMessage === '' && items.length === 0}}">
    <view class="section-title">没有匹配结果</view>
    <view class="hint">试试其他关键词，或清除筛选。</view>
    <view class="btn btn-ghost" bindtap="onClearFilters">清除筛选</view>
  </view>

  <view wx:for="{{items}}" wx:key="id" class="medicine-card {{item.isArchived ? 'archived' : ''}}" bindtap="onTapMedicine" data-id="{{item.id}}">
    <view class="medicine-card-head">
      <view class="medicine-thumb-box">
        <image wx:if="{{item.coverPhotoPath !== ''}}" class="medicine-thumb" src="{{item.coverPhotoPath}}" mode="aspectFill" />
        <view wx:else class="medicine-thumb placeholder">📦</view>
      </view>
      <view class="medicine-head-main">
        <view class="medicine-topline">
          <view class="medicine-name">{{item.name}}</view>
          <view class="badge badge-{{item.stateClass}}">{{item.stateLabel}}</view>
        </view>
        <view class="medicine-spec">{{item.specification}}</view>
      </view>
    </view>
    <view class="tag-row" wx:if="{{item.displayTags.length > 0}}">
      <text class="medicine-tag {{tag.kind}}" wx:for="{{item.displayTags}}" wx:for-item="tag" wx:key="index">{{tag.label}}</text>
      <text class="medicine-tag more" wx:if="{{item.extraTagCount > 0}}">+{{item.extraTagCount}}</text>
    </view>
    <view class="medicine-summary">
      <view class="summary-primary">{{item.quantityText}}</view>
      <view class="summary-separator">·</view>
      <view class="expiry-line">{{item.expiryText}}</view>
    </view>
    <view class="medicine-status-row" wx:if="{{item.isArchived || item.openedText !== ''}}">
      <text wx:if="{{item.isArchived}}" class="status-pill archived">已归档</text>
      <text wx:if="{{item.openedText !== ''}}" class="status-pill opened">{{item.openedText}}</text>
    </view>
    <view class="stock-warning" wx:if="{{item.stockState === 'low'}}">库存不足</view>
    <view class="stock-warning unknown" wx:elif="{{item.stockState === 'unknown'}}">库存待核对</view>
    <view class="medicine-location" wx:if="{{item.locationText !== ''}}">存放位置：{{item.locationText}}</view>
    <view class="purpose-text">用途：{{item.purpose}}</view>
    <view class="detail-hint">查看批次与说明书 ›</view>
  </view>

  <view class="safety-note">清单只用于家庭库存管理；库存存在不等于适合服用。请以药品说明书及医生或药师指导为准。</view>
  <view class="bottom-spacer"></view>
  <view class="floating-add" bindtap="onTapAdd" aria-label="录入药品">＋ <text>录入药品</text></view>

  <view class="entry-sheet-layer" wx:if="{{entrySheetVisible}}" catchtouchmove="noop">
    <view class="entry-sheet-mask" bindtap="onCloseEntrySheet"></view>
    <view class="entry-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">录入家里的药</view>
      <view class="sheet-hint">拍照识别只生成草稿，核对后才保存。</view>
      <view class="sheet-option" data-action="camera" bindtap="onSelectEntry">
        <view class="sheet-icon">📷</view>
        <view class="sheet-option-main"><view class="sheet-option-title">拍照识别</view><view class="sheet-option-hint">请求相机权限，识别结果待核对</view></view>
        <view class="sheet-arrow">›</view>
      </view>
      <view class="sheet-option" data-action="album" bindtap="onSelectEntry">
        <view class="sheet-icon album">▣</view>
        <view class="sheet-option-main"><view class="sheet-option-title">从相册选择</view><view class="sheet-option-hint">选择已有药盒照片</view></view>
        <view class="sheet-arrow">›</view>
      </view>
      <view class="sheet-option" data-action="manual" bindtap="onSelectEntry">
        <view class="sheet-icon">✎</view>
        <view class="sheet-option-main"><view class="sheet-option-title">手动录入</view><view class="sheet-option-hint">只填药品名称也可以先保存</view></view>
        <view class="sheet-arrow">›</view>
      </view>
      <view class="sheet-option" data-action="scan" bindtap="onSelectEntry">
        <view class="sheet-icon scan">▦</view>
        <view class="sheet-option-main"><view class="sheet-option-title">扫码查候选</view><view class="sheet-option-hint">查询结果需人工确认后填入</view></view>
        <view class="sheet-arrow">›</view>
      </view>
    </view>
  </view>
</view>
