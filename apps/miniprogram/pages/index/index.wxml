<view class="page">
  <view class="hero">
    <view class="eyebrow">{{stageLabel}}</view>
    <view class="title">家里的药，心里有数</view>
    <view class="subtitle" wx:if="{{familyName !== ''}}">家庭：{{familyName}}</view>
    <view class="subtitle" wx:else>记录库存和有效期，让药品信息容易核对。</view>
  </view>

  <view class="status-card">
    <view>
      <view class="status-title">临期 / 过期提醒</view>
      <view class="status-hint">有效期按每一盒分别记录，仅供参考</view>
    </view>
    <view class="status-numbers">
      <view class="status-count">{{expiringCount}}<text> 项临期</text></view>
      <view class="status-count expired">{{expiredCount}}<text> 项过期</text></view>
    </view>
  </view>

  <view class="toolbar">
    <view class="tool-btn primary" bindtap="onTapAdd">＋ 录入药品</view>
    <view class="tool-btn" bindtap="onTapExport">导出 Markdown</view>
    <view class="tool-btn" bindtap="onTapInvite">家庭共享</view>
  </view>

  <view class="search-box">
    <input
      class="search-input"
      placeholder="搜索药名（本机快速筛选）"
      value="{{keyword}}"
      bindinput="onSearchInput"
      confirm-type="search"
    />
    <view class="sample-pill" wx:if="{{isExample}}">合成示例</view>
    <view class="sample-pill" wx:elif="{{isFiltered}}">筛选中</view>
  </view>

  <view class="card error-card" wx:if="{{errorMessage !== ''}}">
    <view class="section-title">暂时无法加载药箱</view>
    <view class="hint">{{errorMessage}}</view>
    <view class="btn btn-ghost retry-btn" bindtap="onRetry">重新连接</view>
  </view>

  <view class="empty-card" wx:if="{{errorMessage === '' && items.length === 0}}">
    <view class="section-title">还没有药品</view>
    <view class="hint">可以拍照识别，或先只填写药品名称保存。</view>
    <view class="btn btn-primary" bindtap="onTapAdd">录入第一种药</view>
  </view>

  <view wx:for="{{items}}" wx:key="id" class="medicine-card" bindtap="onTapMedicine" data-id="{{item.id}}">
    <view class="medicine-left">
      <view class="medicine-name">{{item.name}}</view>
      <view class="medicine-spec">{{item.specification}}</view>
      <view class="medicine-stock">{{item.quantityText}}</view>
      <view class="expiry-line">{{item.expiryText}}</view>
    </view>
    <view class="medicine-right">
      <view class="purpose-label">简要用途</view>
      <view class="purpose-text">{{item.purpose}}</view>
      <view class="badge badge-{{item.state}}">{{item.state}}</view>
      <view class="detail-hint" wx:if="{{!item.isExample}}">查看批次与备注 ›</view>
    </view>
  </view>

  <view class="safety-note">
    库存清单用于家庭管理，库存存在不等于适合服用。请以包装内说明书及医生或药师的指导为准。
  </view>

  <view class="entry-sheet-layer" wx:if="{{entrySheetVisible}}" catchtouchmove="noop">
    <view class="entry-sheet-mask" bindtap="onCloseEntrySheet"></view>
    <view class="entry-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">录入家里的药</view>
      <view class="sheet-hint">拍照优先；识别结果会进入人工核对，不会直接入库。</view>
      <view class="sheet-option" data-action="camera" bindtap="onSelectEntry">
        <view class="sheet-icon">📷</view>
        <view class="sheet-option-main"><view class="sheet-option-title">拍照识别</view><view class="sheet-option-hint">请求相机权限，识别药盒和有效期</view></view>
        <view class="sheet-arrow">›</view>
      </view>
      <view class="sheet-option" data-action="album" bindtap="onSelectEntry">
        <view class="sheet-icon album">▣</view>
        <view class="sheet-option-main"><view class="sheet-option-title">从相册选择</view><view class="sheet-option-hint">选择已有药盒照片</view></view>
        <view class="sheet-arrow">›</view>
      </view>
      <view class="sheet-option" data-action="manual" bindtap="onSelectEntry">
        <view class="sheet-icon">✎</view>
        <view class="sheet-option-main"><view class="sheet-option-title">手动录入</view><view class="sheet-option-hint">只填药品名称也可以先保存</view></view>
        <view class="sheet-arrow">›</view>
      </view>
    </view>
  </view>
</view>
