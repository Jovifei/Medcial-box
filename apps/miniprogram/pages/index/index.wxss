/* Apple 内容优先：连续库存列表、轻分组、单一主动作。 */
.page { padding: 16px 16px calc(100px + env(safe-area-inset-bottom)); }
.home-page { min-height: 100vh; box-sizing: border-box; background: var(--med-background, #f2f2f7); }
.home-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 4px 0 20px; }
.home-heading { flex: 1; min-width: 0; }
.title { color: var(--med-label, #1c1c1e); font-size: 28px; font-weight: 400; line-height: 1.25; }
.home-subtitle { margin-top: 6px; color: var(--med-secondary, #636366); font-size: 12px; line-height: 1.5; }
.family-capsule { display: flex; align-items: center; gap: 8px; flex: 0 1 152px; min-width: 0; max-width: 47%; min-height: 48px; padding: 8px 10px; box-sizing: border-box; border-radius: 10px; background: #fff; color: var(--med-accent, #087f5b); }
.family-icon { position: relative; width: 16px; height: 18px; flex: none; }
.family-roof { position: absolute; left: 3px; top: 2px; width: 10px; height: 10px; border-left: 1.5px solid currentColor; border-top: 1.5px solid currentColor; transform: rotate(45deg); }
.family-house { position: absolute; left: 3px; bottom: 0; width: 10px; height: 9px; border: 1.5px solid currentColor; border-top: 0; border-radius: 0 0 2px 2px; }
.family-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.family-label { color: var(--med-secondary, #636366); font-size: 11px; }
.family-name { margin-top: 2px; color: var(--med-label, #1c1c1e); font-size: 13px; line-height: 1.4; overflow-wrap: anywhere; }
.family-chevron { width: 5px; height: 5px; flex: none; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); }
.search-box { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; padding: 0 12px; border-radius: 10px; background: #e8e8ed; }
.search-icon { position: relative; width: 18px; height: 18px; flex: none; }
.search-lens { position: absolute; left: 1px; top: 1px; width: 10px; height: 10px; border: 1.5px solid var(--med-secondary, #636366); border-radius: 50%; }
.search-lens::after { position: absolute; right: -5px; bottom: -3px; width: 6px; height: 1.5px; border-radius: 2px; background: var(--med-secondary, #636366); content: ""; transform: rotate(45deg); }
.search-input { flex: 1; min-width: 0; height: 48px; font-size: 13px; text-align: left; }
.clear-search { min-width: 48px; min-height: 48px; display: flex; align-items: center; justify-content: center; color: var(--med-accent, #087f5b); font-size: 13px; }
.attention-summary { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 48px; margin-bottom: 8px; padding: 10px 12px; box-sizing: border-box; border-radius: 10px; background: #fff; color: var(--med-label, #1c1c1e); font-size: 13px; line-height: 1.5; }
.attention-copy { display: flex; align-items: center; min-width: 0; gap: 10px; }
.attention-dot { width: 7px; height: 7px; flex: none; border-radius: 50%; background: #c47700; }
.attention-link { flex: none; color: var(--med-accent, #087f5b); }
.attention-retry { min-height: 48px; display: flex; align-items: center; margin-bottom: 8px; color: var(--med-accent, #087f5b); font-size: 13px; }
.filter-scroll { width: calc(100% + 32px); margin: 0 -16px 4px; }
.filter-toolbar { display: flex; width: max-content; gap: 8px; padding: 0 16px 4px; }
.filter-chip { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; min-width: 48px; box-sizing: border-box; padding: 8px 12px; border: 1px solid transparent; border-radius: 10px; background: #fff; color: var(--med-secondary, #636366); font-size: 13px; line-height: 1.4; }
.filter-chip.selected { border-color: var(--med-accent, #087f5b); color: var(--med-accent, #087f5b); background: var(--med-accent-tint, #edf6f2); font-weight: 600; }
.filter-panel { margin-bottom: 8px; padding: 8px 12px 12px; }
.filter-panel-heading, .filter-summary { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.filter-panel-heading .section-title { font-size: 15px; margin: 0; }
.filter-summary { padding: 0 4px; margin-bottom: 8px; }
.filter-summary .hint { flex: 1; min-width: 0; font-size: 12px; overflow-wrap: anywhere; }
.tag-picker { display: flex; flex-wrap: wrap; gap: 8px; }
.error-card { margin-top: 12px; background: var(--med-danger-tint, #fff0ee); }
.retry-btn { margin-top: 12px; }
.empty-card { margin-top: 12px; padding: 28px 20px; border-radius: 12px; background: #fff; text-align: center; }
.empty-card .section-title { font-size: 18px; text-align: center; }
.empty-card .hint { font-size: 13px; text-align: center; overflow-wrap: anywhere; }
.empty-mark { margin-bottom: 16px; }
.empty-pill-art { width: 36px; height: 18px; margin: 0 auto; border: 2px solid var(--med-accent, #087f5b); border-radius: 12px; transform: rotate(-30deg); }
.list-caption { margin: 12px 4px 8px; font-size: 12px; color: var(--med-secondary, #636366); }
.medicine-list { border-radius: 12px; overflow: hidden; background: #fff; }
.medicine-card { padding: 16px; border-bottom: 1px solid var(--med-inset, #f2f2f7); background: #fff; }
.medicine-card:last-child { border-bottom: 0; }
.medicine-card.archived { background: #fafafa; }
.medicine-card-head { display: flex; align-items: flex-start; gap: 12px; }
.medicine-thumb-box { flex: 0 0 auto; }
.medicine-thumb { width: 46px; height: 46px; border-radius: 10px; background: var(--med-inset, #f2f2f7); }
.medicine-thumb.placeholder { display: flex; align-items: center; justify-content: center; }
.pill-svg-icon { width: 24px; height: 12px; border: 1.5px solid var(--med-secondary, #636366); border-radius: 10px; transform: rotate(-30deg); }
.pill-svg-icon::after { content: ""; display: block; width: 50%; height: 100%; border-right: 1px solid var(--med-secondary, #636366); }
.medicine-head-main { flex: 1; min-width: 0; }
.medicine-topline { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 6px 8px; }
.medicine-name { flex: 1 1 100px; min-width: 0; color: var(--med-label, #1c1c1e); font-size: 16px; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
.badge { max-width: 100%; font-size: 11px; padding: 3px 6px; border-radius: 5px; white-space: normal; }
.medicine-spec { margin-top: 4px; color: var(--med-secondary, #636366); font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }
.medicine-summary { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 10px; margin: 10px 0 0 58px; }
.summary-metric { display: flex; min-width: 0; flex-direction: column; }
.summary-label { color: var(--med-secondary, #636366); font-size: 11px; }
.summary-primary, .expiry-line { color: var(--med-label, #1c1c1e); font-size: 13px; line-height: 1.5; overflow-wrap: anywhere; }
.summary-divider { display: none; }
.tag-row, .medicine-status-row { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 0 58px; }
.medicine-tag, .status-pill { padding: 2px 6px; border-radius: 5px; font-size: 11px; line-height: 1.5; color: var(--med-secondary, #636366); background: var(--med-inset, #f2f2f7); }
.stock-warning { margin: 8px 0 0 58px; color: var(--med-warning, #8a5700); font-size: 12px; line-height: 1.5; }
.stock-warning.unknown { color: var(--med-secondary, #636366); }
.safety-note { padding: 20px 4px 0; color: var(--med-secondary, #636366); font-size: 11px; line-height: 1.6; }
.bottom-spacer { height: 8px; }
.floating-add { position: fixed; z-index: 10; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 48px; box-sizing: border-box; padding: 12px 18px; border-radius: 12px; background: var(--med-accent, #087f5b); color: #fff; font-size: 18px; font-weight: 600; box-shadow: 0 3px 12px rgba(0,0,0,.12); }
.floating-add text { font-size: 14px; }
.highlighted { box-shadow: inset 3px 0 var(--med-accent, #087f5b); }
@media (max-width: 340px) { .home-header { gap: 8px; } .family-capsule { padding: 8px; } .family-icon { display: none; } .medicine-card { padding: 14px 12px; } }
