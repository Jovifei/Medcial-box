.page {
  padding: 24rpx 24rpx calc(150rpx + env(safe-area-inset-bottom));
}

.home-header {
  padding: 8rpx 0 16rpx;
  text-align: left;
}

.family-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.family-capsule {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 10rpx 24rpx;
  border: 1rpx solid #d1fae5;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 26rpx;
  font-weight: 600;
}
.family-icon { position: relative; width: 26rpx; height: 26rpx; flex: none; }
.family-roof { position: absolute; left: 5rpx; top: 2rpx; width: 15rpx; height: 15rpx; border-left: 3rpx solid currentColor; border-top: 3rpx solid currentColor; transform: rotate(45deg); }
.family-house { position: absolute; left: 5rpx; bottom: 1rpx; width: 16rpx; height: 13rpx; border: 3rpx solid currentColor; border-top: 0; border-radius: 0 0 3rpx 3rpx; }
.family-arrow { font-size: 20rpx; color: #059669; }

.attention-summary { display: flex; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; padding: 22rpx 24rpx; border: 1rpx solid #efd4cb; border-radius: 18rpx; background: #fff8f5; color: #934b32; font-size: 26rpx; }
.attention-summary text:first-child { min-width: 0; }

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 0 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e1e7e1;
  border-radius: 16rpx;
  background: #fff;
}

.search-icon { color: #7c8a80; font-size: 36rpx; }
.search-input { flex: 1; min-width: 0; height: 88rpx; font-size: 30rpx; text-align: left; }
.clear-search { padding: 10rpx 4rpx 10rpx 12rpx; color: #3f7d5c; font-size: 22rpx; }

.filter-row { width: 100%; white-space: nowrap; margin-bottom: 24rpx; }
.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-right: 12rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid #e1e7e1;
  border-radius: 999rpx;
  background: #fff;
  color: #52685c;
  font-size: 22rpx;
}
.filter-chip text { color: #7c867e; font-size: 22rpx; }
.filter-chip.selected { border-color: #3f7d5c; background: #e9f2ec; color: #315f46; }

.error-card { margin-top: 24rpx; border-color: #efd4cb; background: #fff8f5; border-radius: 24rpx; }
.retry-btn { margin-top: 24rpx; }
.empty-card {
  margin-top: 24rpx;
  padding: 40rpx 24rpx;
  border: 1rpx dashed #c8d4ca;
  border-radius: 24rpx;
  background: #fff;
  text-align: center;
}
.empty-mark { margin-bottom: 16rpx; color: #3f7d5c; font-size: 64rpx; }

.medicine-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #e9ede8;
  border-radius: 24rpx;
  background: #fff;
}
.medicine-card.archived { background: #f6f7f5; border-color: #e4e8e4; opacity: 0.94; }
.medicine-card-head { display: flex; align-items: flex-start; gap: 16rpx; }
.medicine-thumb-box { flex: 0 0 auto; }
.medicine-thumb { width: 96rpx; height: 96rpx; border-radius: 16rpx; background: #eef1ee; }
.medicine-thumb.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
}

.pill-svg-icon {
  width: 44rpx;
  height: 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(to right, #047857 50%, #cbd5e1 50%);
  transform: rotate(-30deg);
}

.empty-pill-art {
  width: 72rpx;
  height: 36rpx;
  margin: 0 auto 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(to right, #047857 50%, #cbd5e1 50%);
  transform: rotate(-15deg);
}
.medicine-head-main { flex: 1; min-width: 0; text-align: left; }
.medicine-status-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.status-pill { display: inline-flex; align-items: center; padding: 4rpx 14rpx; border-radius: 999rpx; font-size: 22rpx; }
.status-pill.opened { color: #8a5a24; background: #f7ead6; }
.status-pill.archived { color: #657168; background: #e9ece9; }
.medicine-location { margin-top: 12rpx; color: #71807a; font-size: 22rpx; line-height: 1.5; overflow-wrap: anywhere; text-align: left; }
.medicine-topline, .medicine-summary { display: flex; align-items: center; gap: 12rpx; }
.medicine-topline { justify-content: space-between; }
.medicine-name { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; text-align: left; }
.medicine-spec { margin-top: 6rpx; color: #52685c; font-size: 26rpx; text-align: left; }
.medicine-summary { flex-wrap: wrap; margin-top: 16rpx; }
.summary-primary { color: #315f46; font-size: 30rpx; font-weight: 650; }
.summary-separator { color: #9da79f; }
.expiry-line { color: #52685c; font-size: 30rpx; }
.stock-warning {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff0e9;
  color: #a45437;
  font-size: 22rpx;
}
.stock-warning.unknown { background: #edf0ec; color: #657168; }
.purpose-text { margin-top: 14rpx; color: #44574b; font-size: 22rpx; line-height: 1.55; overflow-wrap: anywhere; text-align: left; }
.detail-hint { margin-top: 12rpx; color: #829087; font-size: 22rpx; }
.safety-note { padding: 24rpx 0 0; color: #7c867e; font-size: 22rpx; line-height: 1.6; text-align: left; }
.bottom-spacer { height: 24rpx; }

.floating-add {
  position: fixed;
  z-index: 10;
  right: 30rpx;
  bottom: calc(116rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: #3f7d5c;
  box-shadow: 0 8rpx 24rpx rgba(36, 68, 49, 0.2);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}
.floating-add text { font-size: 24rpx; }

/* —— 人群/用途整理标签（R2-b）：蓝=成人、绿=儿童、紫=用途，灰=+N；状态同时用文字表达 —— */
.tag-filter-row {
  margin-top: 12rpx;
}

.tag-chip.selected {
  background: #3f7d5c;
  color: #ffffff;
  border-color: #3f7d5c;
}

.sort-picker {
  display: inline-block;
}

.sort-chip {
  color: #3f7d5c;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 8rpx 0;
}

.medicine-tag {
  font-size: 22rpx;
  line-height: 1.5;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}

.medicine-tag.pop-adult {
  color: #1d5fd1;
  background: #e3edfb;
}

.medicine-tag.pop-child {
  color: #2f7d4f;
  background: #e2f2e8;
}

.medicine-tag.purpose {
  color: #6b3fa0;
  background: #efe7f9;
}

.medicine-tag.more {
  color: #596a60;
  background: #eef1ee;
}

.filter-toolbar { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 20rpx; }
.filter-toolbar .filter-chip { display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 8rpx 4rpx; box-sizing: border-box; margin: 0; font-size: 26rpx; }
.highlighted { box-shadow: 0 0 0 4rpx #63a980; }
.tag-picker { display: flex; flex-wrap: wrap; gap: 10rpx; }
