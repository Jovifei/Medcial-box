.page {
  padding: 20rpx 30rpx calc(150rpx + env(safe-area-inset-bottom));
}

.home-header {
  padding: 12rpx 2rpx 24rpx;
}

.family-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.family-caption { color: #7c867e; font-size: 21rpx; }
.family-name { margin-top: 4rpx; font-size: 27rpx; font-weight: 700; }
.family-link {
  padding: 14rpx 18rpx;
  border: 1rpx solid #dfe7df;
  border-radius: 999rpx;
  background: #fff;
  color: #3f7d5c;
  font-size: 22rpx;
}

.title { font-size: 39rpx; font-weight: 700; line-height: 1.35; }
.subtitle { margin-top: 8rpx; color: #718078; font-size: 23rpx; }

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 0 18rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e1e7e1;
  border-radius: 16rpx;
  background: #fff;
}

.search-icon { color: #7c8a80; font-size: 40rpx; }
.search-input { flex: 1; min-width: 0; height: 88rpx; font-size: 25rpx; }
.clear-search { padding: 10rpx 4rpx 10rpx 12rpx; color: #3f7d5c; font-size: 22rpx; }

.filter-row { width: 100%; white-space: nowrap; margin-bottom: 20rpx; }
.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-right: 12rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #e1e7e1;
  border-radius: 999rpx;
  background: #fff;
  color: #52685c;
  font-size: 22rpx;
}
.filter-chip text { color: #7c867e; font-size: 20rpx; }
.filter-chip.selected { border-color: #3f7d5c; background: #e9f2ec; color: #315f46; }

.error-card { margin-top: 22rpx; border-color: #efd4cb; background: #fff8f5; }
.retry-btn { margin-top: 18rpx; }
.empty-card {
  margin-top: 22rpx;
  padding: 30rpx 24rpx;
  border: 1rpx dashed #c8d4ca;
  border-radius: 20rpx;
  background: #fff;
  text-align: center;
}
.empty-mark { margin-bottom: 12rpx; color: #3f7d5c; font-size: 60rpx; }

.medicine-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e9ede8;
  border-radius: 20rpx;
  background: #fff;
}
.medicine-topline, .medicine-summary { display: flex; align-items: center; gap: 12rpx; }
.medicine-topline { justify-content: space-between; }
.medicine-name { flex: 1; min-width: 0; font-size: 29rpx; font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
.medicine-spec { margin-top: 6rpx; color: #778279; font-size: 21rpx; }
.medicine-summary { flex-wrap: wrap; margin-top: 16rpx; }
.summary-primary { color: #315f46; font-size: 25rpx; font-weight: 650; }
.summary-separator { color: #9da79f; }
.expiry-line { color: #778279; font-size: 22rpx; }
.stock-warning {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #fff0e9;
  color: #a45437;
  font-size: 20rpx;
}
.stock-warning.unknown { background: #edf0ec; color: #657168; }
.purpose-text { margin-top: 14rpx; color: #44574b; font-size: 22rpx; line-height: 1.55; overflow-wrap: anywhere; }
.detail-hint { margin-top: 12rpx; color: #829087; font-size: 20rpx; }
.safety-note { padding: 26rpx 8rpx 0; color: #7c867e; font-size: 21rpx; line-height: 1.6; }
.bottom-spacer { height: 18rpx; }

.floating-add {
  position: fixed;
  z-index: 10;
  right: 30rpx;
  bottom: calc(116rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: #3f7d5c;
  box-shadow: 0 8rpx 24rpx rgba(36, 68, 49, 0.2);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}
.floating-add text { font-size: 24rpx; }

.entry-sheet-layer { position: fixed; z-index: 20; inset: 0; }
.entry-sheet-mask { position: absolute; inset: 0; background: rgba(21, 34, 27, 0.42); }
.entry-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 88vh;
  overflow-y: auto;
  padding: 18rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #f5f7f4;
  box-shadow: 0 -12rpx 40rpx rgba(35, 53, 44, 0.14);
}
.sheet-handle { width: 70rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 99rpx; background: #dce5de; }
.sheet-title { font-size: 34rpx; font-weight: 720; }
.sheet-hint { margin-top: 8rpx; color: #718078; font-size: 22rpx; line-height: 1.5; }
.sheet-option {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 22rpx 20rpx;
  border: 1rpx solid #e1e9e2;
  border-radius: 20rpx;
  background: #fff;
}
.sheet-icon { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e3f0e7; color: #315f46; font-size: 34rpx; }
.sheet-icon.album { background: #f6ead4; }
.sheet-icon.scan { background: #e8eef4; }
.sheet-option-main { flex: 1; min-width: 0; }
.sheet-option-title { color: #24352c; font-size: 29rpx; font-weight: 680; }
.sheet-option-hint { margin-top: 6rpx; color: #718078; font-size: 21rpx; line-height: 1.45; }
.sheet-arrow { color: #7c8b80; font-size: 42rpx; }

/* —— 人群/用途整理标签（R2-b）：蓝=成人、绿=儿童、紫=用途，灰=+N；状态同时用文字表达 —— */
.tag-filter-row {
  margin-top: 12rpx;
}

.tag-chip.selected {
  background: #3f7d5c;
  color: #ffffff;
  border-color: #3f7d5c;
}

.sort-picker {
  display: inline-block;
}

.sort-chip {
  color: #3f7d5c;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 8rpx 0;
}

.medicine-tag {
  font-size: 22rpx;
  line-height: 1.5;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}

.medicine-tag.pop-adult {
  color: #1d5fd1;
  background: #e3edfb;
}

.medicine-tag.pop-child {
  color: #2f7d4f;
  background: #e2f2e8;
}

.medicine-tag.purpose {
  color: #6b3fa0;
  background: #efe7f9;
}

.medicine-tag.more {
  color: #596a60;
  background: #eef1ee;
}
