.page { padding-bottom: 60rpx; }
.home-header { padding: 18rpx 4rpx 24rpx; }
.title { font-size: 38rpx; font-weight: 700; }
.subtitle { margin-top: 8rpx; color: var(--med-secondary, #636366); font-size: 22rpx; line-height: 1.55; }
.error-card { border-color: var(--med-danger-line, #efc8c3); background: var(--med-danger-tint, #fff0ee); }
.empty-card { margin-top: 18rpx; padding: 38rpx 24rpx; border: 1rpx dashed var(--med-line, #dcdce1); border-radius: 20rpx; background: #fff; text-align: center; }
.empty-mark { margin-bottom: 12rpx; color: var(--med-accent, #087f5b); font-size: 56rpx; }
.pending-card { padding: 24rpx; }
.pending-type { display: inline-block; padding: 6rpx 12rpx; border-radius: 999rpx; background: var(--med-danger-tint, #fff0ee); color: var(--med-danger, #b42318); font-size: 20rpx; }
.pending-name { margin-top: 12rpx; font-size: 28rpx; font-weight: 700; }
.pending-label { margin-top: 8rpx; color: var(--med-secondary, #636366); font-size: 23rpx; line-height: 1.55; }
.pending-date { margin-top: 6rpx; color: var(--med-secondary, #636366); font-size: 21rpx; }
.footnote { margin: 22rpx 8rpx; }
