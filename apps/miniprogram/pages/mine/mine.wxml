<view class="page">
  <view class="card mine-family">
    <view class="family-caption">当前家庭</view>
    <view class="family-name">{{familyName || (loading ? "正在读取…" : "尚未加入家庭")}}</view>
    <view class="hint">{{roleLabel}}</view>
    <view class="hint" wx:if="{{errorMessage}}">{{errorMessage}} <text class="retry-link" bindtap="onRetry">重试</text></view>
  </view>

  <view class="section-label">常用入口</view>
  <view class="entry-grid">
    <view class="entry-card" bindtap="onOpenItem" data-route="family"><view class="entry-mark">家</view><view class="menu-title">我的家庭</view><view class="menu-hint">成员与家庭设置</view></view>
    <view class="entry-card" bindtap="onOpenItem" data-route="care"><view class="entry-mark">护</view><view class="menu-title">照护对象</view><view class="menu-hint">照护与共享权限</view></view>
    <view class="entry-card" bindtap="onOpenItem" data-route="notifications"><view class="entry-mark">醒</view><view class="menu-title">提醒设置</view><view class="menu-hint">时间与微信订阅</view></view>
    <view class="entry-card" bindtap="onOpenItem" data-route="restock"><view class="entry-mark">补</view><view class="menu-title">补货清单</view><view class="menu-hint">需要补充的库存</view></view>
  </view>
  <view class="section-label">数据管理</view>
  <view class="entry-grid">
    <view class="entry-card" bindtap="onOpenItem" data-route="export"><view class="entry-mark">出</view><view class="menu-title">导出清单</view><view class="menu-hint">预览与分享药箱</view></view>
    <view class="entry-card" bindtap="onOpenItem" data-route="backup"><view class="entry-mark">存</view><view class="menu-title">备份与恢复</view><view class="menu-hint">保存与恢复数据</view></view>
    <view class="entry-card" bindtap="onOpenItem" data-route="trash"><view class="entry-mark">回</view><view class="menu-title">最近删除</view><view class="menu-hint">找回药品与批次</view></view>
    <view class="entry-card" bindtap="onOpenItem" data-route="audit"><view class="entry-mark">记</view><view class="menu-title">变更记录</view><view class="menu-hint">查看家庭修改</view></view>
  </view>
  <view class="section-label">设备与其他设置</view>
  <view class="settings-group">
    <view class="menu-card" bindtap="onToggleDevices"><view><view class="menu-title">已登录设备</view><view class="menu-hint">查看有效会话与授权</view></view><view class="menu-arrow">{{deviceExpanded ? "⌃" : "⌄"}}</view></view>
    <view class="devices-card" wx:if="{{deviceExpanded}}">
    <view class="hint" wx:if="{{devicesLoading}}">正在读取设备授权…</view>
    <view class="hint" wx:elif="{{devicesError}}">{{devicesError}}</view>
    <view class="hint" wx:elif="{{devices.length === 0}}">没有其他有效设备会话。</view>
    <view wx:for="{{devices}}" wx:key="id" class="device-row">
      <view class="device-info">
        <view class="device-title">{{item.kindLabel}}{{item.isCurrent ? " · 当前设备" : ""}}</view>
        <view class="hint">登录于 {{item.createdAt}}</view>
        <view class="hint">有效至 {{item.expiresAt}}</view>
        <view class="hint current-device" wx:if="{{item.isCurrent}}">当前小程序会话不能从此处撤销。</view>
        <view class="hint" wx:elif="{{item.clientKind === 'miniprogram'}}">其他小程序会话需在对应设备退出；此处可撤销 Android App。</view>
      </view>
      <view class="btn btn-danger revoke-button" wx:if="{{item.clientKind === 'android' && !item.isCurrent}}" data-id="{{item.id}}" bindtap="onRevokeDevice">{{revokingDeviceId === item.id ? "撤销中…" : "撤销授权"}}</view>
    </view>
    </view>
    <view class="menu-card" bindtap="onOpenItem" data-route="account"><view><view class="menu-title">账号设置</view><view class="menu-hint">显示名与退出登录</view></view><view class="menu-arrow">›</view></view>
    <view class="menu-card" bindtap="onOpenItem" data-route="app"><view><view class="menu-title">连接 Android App</view><view class="menu-hint">确认 App 的临时连接码</view></view><view class="menu-arrow">›</view></view>
    <view class="menu-card" bindtap="onOpenItem" data-route="release"><view><view class="menu-title">版本与更新</view><view class="menu-hint">当前版本 {{appVersion}}</view></view><view class="menu-arrow">›</view></view>
  </view>
  <view class="safety-note">药箱内容仅用于家庭库存管理，不提供诊断、选药或个人剂量建议。</view>
</view>
