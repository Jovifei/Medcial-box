.page { padding-bottom: 60rpx; }
.status-text { margin-top: 14rpx; color: var(--med-accent, #087f5b); }
.error-text, .conflict-text { margin-top: 12rpx; color: var(--med-danger, #b42318); }
.preview-card { margin-top: 18rpx; padding: 18rpx; border: 1rpx solid #dfe7df; border-radius: 16rpx; background: var(--med-inset, #f2f2f7); }
.preview-title { font-size: 25rpx; font-weight: 700; }
.backup-json { width: 100%; height: 240rpx; box-sizing: border-box; margin-top: 14rpx; padding: 14rpx; border: 1rpx solid var(--med-line, #dcdce1); border-radius: 12rpx; background: var(--med-background, #f2f2f7); font-size: 20rpx; }
.safety-note { margin: 22rpx 8rpx; color: var(--med-secondary, #636366); font-size: 21rpx; line-height: 1.6; }
