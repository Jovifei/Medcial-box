.page {
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--med-background, #f2f2f7);
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  border: 1rpx solid var(--med-line, #dcdce1);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-label {
  margin: 8rpx 0 16rpx 4rpx;
  font-size: 24rpx;
  color: var(--med-secondary, #636366);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--med-label, #1c1c1e);
  margin-bottom: 16rpx;
}

.hint {
  font-size: 25rpx;
  color: var(--med-secondary, #636366);
  line-height: 1.6;
}

.plan-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.plan-medicine {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--med-label, #1c1c1e);
}

.plan-status {
  flex: none;
  margin-left: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.plan-status.active {
  color: var(--med-success, #146c43);
  background: var(--med-success-tint, #e9f6ee);
}

.plan-status.paused {
  color: var(--med-secondary, #636366);
  background: var(--med-inset, #f2f2f7);
}

.plan-status.ended {
  color: var(--med-secondary, #636366);
  background: var(--med-inset, #f2f2f7);
}

.plan-line {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: var(--med-secondary, #636366);
  line-height: 1.5;
}

.permission-note {
  margin-top: 16rpx;
  color: var(--med-warning, #8a5700);
}

.plan-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.action-btn {
  min-width: 180rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  font-size: 28rpx;
}

.action-btn.primary {
  background: var(--med-accent, #087f5b);
  color: #ffffff;
}

.action-btn.ghost {
  background: #ffffff;
  border: 1rpx solid var(--med-line, #dcdce1);
  color: var(--med-accent, #087f5b);
}

/* —— 编辑表单 —— */

.field {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid var(--med-line, #dcdce1);
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--med-secondary, #636366);
}

.input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: var(--med-inset, #f2f2f7);
  border: 1rpx solid var(--med-line, #dcdce1);
  font-size: 27rpx;
  color: var(--med-label, #1c1c1e);
}

.picker-box {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: var(--med-inset, #f2f2f7);
  border: 1rpx solid var(--med-line, #dcdce1);
  font-size: 27rpx;
  color: var(--med-label, #1c1c1e);
}

.time-add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time-input {
  flex: 1;
  min-width: 0;
}

.slot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.slot-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--med-accent-tint, #edf6f2);
  color: var(--med-accent, #087f5b);
  font-size: 24rpx;
}

.slot-remove {
  font-size: 26rpx;
  color: var(--med-secondary, #636366);
}

/* —— 历史记录 —— */

.history-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-when {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--med-label, #1c1c1e);
}

.history-status {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.history-status.pending {
  color: var(--med-warning, #8a5700);
  background: var(--med-warning-tint, #fff4de);
}

.history-status.taken {
  color: var(--med-success, #146c43);
  background: var(--med-success-tint, #e9f6ee);
}

.history-status.skipped {
  color: var(--med-secondary, #636366);
  background: var(--med-inset, #f2f2f7);
}

.history-events {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--med-secondary, #636366);
}

.history-corrected {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--med-warning, #8a5700);
}

/* —— 按钮 —— */

.btn {
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-bottom: 16rpx;
}

.btn-primary {
  background: var(--med-accent, #087f5b);
  color: #ffffff;
}

.btn-ghost {
  background: #ffffff;
  border: 1rpx solid var(--med-line, #dcdce1);
  color: var(--med-secondary, #636366);
}

.btn.disabled {
  opacity: 0.55;
}

.leave-mask { position: fixed; z-index: 100; inset: 0; background: rgba(20,30,24,.42); display: flex; align-items: flex-end; }
.leave-sheet { background: white; width: 100%; padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); }
/* 系统分组卡与自适应按钮，避免大字/窄屏裁切。 */
.page { padding: 16px 16px calc(24px + env(safe-area-inset-bottom)); }
.card, .field { border: 0; border-radius: 12px; padding: 16px; }
.plan-top, .history-top, .row-line, .time-add-row { flex-wrap: wrap; gap: 8px; }
.plan-medicine { font-size: 20px; font-weight: 400; overflow-wrap: anywhere; }
.plan-line, .hint { font-size: 13px; overflow-wrap: anywhere; }
.action-btn, .btn, .picker-box, .input { min-height: 48px; height: auto; line-height: 1.4; padding: 10px 12px; box-sizing: border-box; }
.action-btn { flex: 1 1 96px; min-width: 0; display: flex; align-items: center; justify-content: center; border-radius: 10px; font-size: 14px; }
.slot-chip { max-width: 100%; flex-wrap: wrap; }
.slot-remove { min-width: 48px; min-height: 48px; display: inline-flex; align-items: center; justify-content: center; }
.leave-sheet { box-sizing: border-box; max-height: 85vh; overflow-y: auto; border-radius: 16px 16px 0 0; }
