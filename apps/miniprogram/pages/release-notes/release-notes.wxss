.page {
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--med-background, #f2f2f7);
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  border: 1rpx solid var(--med-line, #dcdce1);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-label {
  margin: 8rpx 0 16rpx 4rpx;
  font-size: 24rpx;
  color: var(--med-secondary, #636366);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--med-label, #1c1c1e);
  margin-bottom: 16rpx;
}

.hint {
  font-size: 25rpx;
  color: var(--med-secondary, #636366);
  line-height: 1.6;
}

.note-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.note-version {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--med-label, #1c1c1e);
}

.note-badge {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--med-success-tint, #e9f6ee);
  color: var(--med-success, #146c43);
  font-size: 21rpx;
}

.note-date {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--med-secondary, #636366);
}

.note-item {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--med-secondary, #636366);
  line-height: 1.7;
}

.safety-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--med-secondary, #636366);
  line-height: 1.6;
  text-align: center;
}
