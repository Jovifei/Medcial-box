<view class="page">
  <view class="card" wx:if="{{batchLoading}}">
    <view class="section-title">正在加载批次…</view>
    <view class="field-hint">加载完成前不能保存，避免把编辑误记成新增批次。</view>
  </view>
  <view class="card" wx:elif="{{loadFailed}}">
    <view class="section-title">批次未能加载</view>
    <view class="field-hint">可能是网络中断或该批次已被删除。请重试；此页面不会变成新增。</view>
    <view class="btn btn-ghost" bindtap="onRetryLoad">重新加载</view>
  </view>
  <view class="card">
    <view class="section-title">{{isEdit ? "编辑批次" : "新增批次"}}</view>

    <view class="field">
      <view class="field-label">批次号</view>
      <input class="input" data-field="lotNumber" bindinput="onFieldInput" value="{{lotNumber}}" placeholder="留空记为“批次号未记录”" />
    </view>
    <view class="field">
      <view class="field-label">有效期至</view>
      <medicine-date-field clearable="{{true}}" allow-precision="{{true}}" value="{{expiryValue}}" precision="{{precisionIndex === 2 ? 'unknown' : precisionIndex === 1 ? 'month' : 'day'}}" label="选择包装有效期" bindchange="onExpiryDateChange" />
      <view class="field-hint">仅到月时按“过完该月才过期、当月为本月到期”判断，不伪造日期。</view>
    </view>
    <view class="field">
      <view class="field-label">单位</view>
      <picker range="{{unitLabels}}" value="{{unitIndex}}" bindchange="onUnitChange">
        <view class="picker-box">{{unitLabels[unitIndex]}}</view>
      </picker>
    </view>
    <view class="row">
      <view class="field-label">数量未知</view>
      <switch checked="{{quantityUnknown}}" bindchange="onUnknownChange" />
    </view>
    <view class="field" wx:if="{{!quantityUnknown}}">
      <view class="field-label">数量（0 表示确定耗尽）</view>
      <input class="input" type="number" data-field="quantity" bindinput="onFieldInput" value="{{quantity}}" />
    </view>
    <view class="field">
      <view class="field-label">换算后的单位</view><picker range="{{unitLabels}}" value="{{conversionUnitIndex}}" bindchange="onConversionUnitChange"><view class="picker-box">{{unitLabels[conversionUnitIndex]}}</view></picker>
      <view class="field-label">每包装换算数（本人已确认后填写）</view>
      <input class="input" type="number" data-field="confirmedUnits" bindinput="onFieldInput" value="{{confirmedUnits}}" placeholder="例如：24" />
    </view>
    <view class="field">
      <view class="field-label">存放位置</view>
      <input class="input" data-field="storageLocation" bindinput="onFieldInput" value="{{storageLocation}}" placeholder="例如：客厅药箱" />
    </view>
    <view class="opening-toggle" bindtap="onToggleOpeningInfo">{{openingExpanded ? "收起开封信息" : "＋ 开封管理（选填）"}}</view>
    <view wx:if="{{openingExpanded}}">
      <view class="field">
        <view class="field-label">开封状态</view>
        <picker range="{{openedStateLabels}}" value="{{openedStateIndex}}" bindchange="onOpenedStateChange">
          <view class="picker-box">{{openedStateLabels[openedStateIndex]}}</view>
        </picker>
      </view>
    </view>
    <view wx:if="{{openingExpanded && openedState === 'opened'}}">
      <view class="field">
        <view class="field-label">开封日期（选填）</view>
        <medicine-date-field clearable="{{true}}" value="{{openedAt}}" label="选择日期" data-field="openedAt" bindchange="onFieldInput" />
      </view>
      <view class="field">
        <view class="field-label">开封后期限（有依据时填写）</view>
        <picker range="{{openingLimitModeLabels}}" value="{{openingLimitModeIndex}}" bindchange="onOpeningLimitModeChange">
          <view class="picker-box">{{openingLimitModeLabels[openingLimitModeIndex]}}</view>
        </picker>
      </view>
      <view class="field" wx:if="{{openingLimitMode === 'day' || openingLimitMode === 'month'}}">
        <view class="field-label">{{openingLimitMode === 'day' ? '天数' : '月数'}}</view>
        <input class="input" type="number" data-field="openingLimitValue" bindinput="onFieldInput" value="{{openingLimitValue}}" placeholder="正整数" />
      </view>
      <view class="field" wx:if="{{openingLimitMode === 'date'}}">
        <view class="field-label">开封后截止日期</view>
        <medicine-date-field clearable="{{true}}" value="{{openingLimitValue}}" label="选择日期" data-field="openingLimitValue" bindchange="onFieldInput" />
      </view>
      <view class="field" wx:if="{{openingLimitMode !== 'none'}}">
        <view class="field-label">期限依据</view>
        <input class="input" data-field="openingLimitSource" bindinput="onFieldInput" value="{{openingLimitSource}}" placeholder="例如：说明书第 8 页" />
      </view>
      <view class="field-hint">期限不清楚时保持“不记录”；不会替你推断期限。</view>
    </view>
  </view>

  <view class="btn btn-primary {{submitting || batchLoading || loadFailed ? 'disabled' : ''}}" bindtap="onSubmit">
    {{submitting ? "保存中…" : (batchLoading ? "加载中，暂不能保存" : (loadFailed ? "请先重新加载" : (isEdit ? "保存批次" : "添加批次")))}}
  </view>
  <view class="btn btn-danger" wx:if="{{isEdit && !batchLoading && !loadFailed}}" bindtap="onDelete">移入最近删除</view>
  <view class="hint footnote">批次数值为空表示"未知"，0 表示"确定耗尽"；导出时会显式标注。</view>
</view>
