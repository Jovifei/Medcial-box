.page {
  padding: 24rpx 24rpx 64rpx;
  text-align: left;
}

.hero-card {
  padding: 28rpx 28rpx 32rpx;
}

.hero-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-edit-link {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  font-size: 26rpx;
  color: var(--med-accent, #087f5b);
  font-weight: 600;
  padding: 8rpx 0;
}

.med-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--med-label, #1c1c1e);
  text-align: left;
}

.med-spec {
  margin-top: 8rpx;
  color: var(--med-secondary, #636366);
  font-size: 26rpx;
  text-align: left;
}

.med-company {
  margin-top: 10rpx;
  color: var(--med-secondary, #636366);
  font-size: 24rpx;
  text-align: left;
}

.company-sep {
  color: #94a3b8;
}

.med-meta {
  margin-top: 12rpx;
  color: var(--med-secondary, #636366);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: left;
}

/* 说明书用法用量只读摘要卡 */
.usage-guide-card {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
  border-radius: 16rpx;
  text-align: left;
}

.usage-guide-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--med-success, #146c43);
  margin-bottom: 10rpx;
}

.usage-guide-icon {
  font-size: 26rpx;
}

.usage-guide-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #1e293b;
  line-height: 1.6;
  word-break: break-word;
}

.guide-tag {
  display: inline-block;
  background: #dcfce7;
  color: var(--med-success, #146c43);
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}

.usage-guide-disclaimer {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--med-line, #dcdce1);
  font-size: 20rpx;
  color: var(--med-secondary, #636366);
  line-height: 1.5;
}

.batch-header-row {
  margin-bottom: 12rpx;
}

/* 折叠区域与更多菜单（方案 §5） */
.section-header {
  align-items: flex-start;
  text-align: left;
}

.section-toggle {
  flex: none;
  margin-left: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--med-inset, #f2f2f7);
  color: var(--med-secondary, #636366);
  font-size: 22rpx;
}

.quick-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.quick-action {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid var(--med-line, #dcdce1);
  color: var(--med-accent, #087f5b);
  font-size: 30rpx;
  font-weight: 600;
}

.batch-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  text-align: left;
}

.batch-action-link {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  font-size: 26rpx;
  color: var(--med-accent, #087f5b);
}

.section-label {
  margin: 8rpx 0 16rpx 4rpx;
  font-size: 26rpx;
  color: var(--med-secondary, #636366);
  text-align: left;
}

.menu-list {
  margin-top: 20rpx;
}

.menu-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid var(--med-line, #dcdce1);
  text-align: left;
}

.more-actions-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.more-action-btn {
  flex: 1;
  min-height: 80rpx;
  margin-top: 0 !important;
}

.menu-title {
  font-size: 30rpx;
  color: var(--med-label, #1c1c1e);
  font-weight: 600;
}

.menu-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--med-secondary, #636366);
}

.menu-arrow {
  color: #a5b0a8;
  font-size: 32rpx;
}

/* 药盒封面：私有图片，下载到本地临时文件后展示 */
.cover-box {
  margin-top: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f2f5f2;
}

.cover-image {
  width: 100%;
  height: 240rpx;
  display: block;
}

.cover-placeholder {
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  color: var(--med-secondary, #636366);
  font-size: 23rpx;
}

.link-btn {
  color: var(--med-accent, #087f5b);
  font-size: 23rpx;
  font-weight: 600;
}

.batch-card {
  margin-top: 14rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid var(--med-inset, #f2f2f7);
  border-radius: 16rpx;
  background: var(--med-background, #f2f2f7);
}

.batch-title {
  font-size: 25rpx;
  font-weight: 650;
}

.batch-line {
  margin-top: 8rpx;
  color: var(--med-secondary, #636366);
  font-size: 22rpx;
}

.batch-edit-hint {
  margin-top: 10rpx;
  color: #8a958d;
  font-size: 20rpx;
}

.batch-action {
  min-height: 48px;
  margin-top: 14rpx;
  font-size: 23rpx;
}

.split-panel {
  margin-top: 14rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid #c8dcca;
  border-radius: 16rpx;
  background: var(--med-accent-tint, #edf6f2);
}

.split-title { margin-bottom: 8rpx; font-size: 25rpx; font-weight: 700; }
.split-field { margin-top: 14rpx; margin-bottom: 0; }
.split-preview { margin-top: 12rpx; padding: 12rpx 14rpx; border-radius: 12rpx; background: #e8f2ea; color: #315e44; font-size: 23rpx; font-weight: 650; line-height: 1.5; }
.split-error { margin-top: 10rpx; color: var(--med-danger, #b42318); font-size: 22rpx; line-height: 1.5; }
.split-actions { display: flex; gap: 12rpx; margin-top: 16rpx; }
.split-actions .btn { flex: 1; min-height: 78rpx; margin-top: 0; padding: 14rpx; font-size: 23rpx; }

.opening-warning {
  color: var(--med-danger, #b42318);
  font-weight: 650;
}

.leaflet-badge {
  margin-top: 4rpx;
}

.leaflet-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
}

.leaflet-photo-section .section-title { margin-bottom: 0; }
.photo-count { color: var(--med-secondary, #636366); font-size: 21rpx; }
.photo-upload { min-height: 48px; margin-top: 16rpx; font-size: 24rpx; }
.photo-status { margin-top: 10rpx; color: var(--med-accent, #087f5b); font-size: 21rpx; line-height: 1.55; }
.photo-error { margin-top: 10rpx; color: var(--med-danger, #b42318); font-size: 21rpx; line-height: 1.55; word-break: break-word; }
.photo-retry { margin-left: 8rpx; color: var(--med-accent, #087f5b); text-decoration: underline; }
.photo-loading,
.photo-empty { margin-top: 16rpx; }
.leaflet-photo-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--med-inset, #f2f2f7); }
.photo-meta { min-width: 0; flex: 1; }
.photo-title { font-size: 23rpx; font-weight: 650; word-break: break-word; }
.photo-actions { display: flex; align-items: center; gap: 16rpx; flex: 0 0 auto; }
.photo-action { min-width: 88rpx; min-height: 88rpx; box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; padding: 12rpx 16rpx; border: 1rpx solid var(--med-line, #dcdce1); border-radius: 999rpx; color: var(--med-accent, #087f5b); text-align: center; font-size: 26rpx; }
.photo-delete { min-height: 88rpx; display: inline-flex; align-items: center; padding: 12rpx 10rpx; color: var(--med-danger, #b42318); font-size: 26rpx; }

.note-card {
  margin-top: 14rpx;
  padding: 16rpx;
  border: 1rpx solid var(--med-inset, #f2f2f7);
  border-radius: 14rpx;
  background: var(--med-background, #f2f2f7);
}

.note-owner {
  color: #648274;
  font-size: 21rpx;
  font-weight: 650;
}

.note-delete {
  color: var(--med-danger, #b42318);
  font-size: 21rpx;
}

.note-content {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

/* —— 整理标签（R2-d）：与药箱首页同一套配色语义 —— */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 10rpx 0;
}

.medicine-tag {
  font-size: 22rpx;
  line-height: 1.5;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}

.medicine-tag.pop-adult {
  color: #1d5fd1;
  background: #e3edfb;
}

.medicine-tag.pop-child {
  color: var(--med-success, #146c43);
  background: var(--med-success-tint, #e9f6ee);
}

.medicine-tag.purpose {
  color: #6b3fa0;
  background: #efe7f9;
}

.quantity-mask { position: fixed; z-index: 100; inset: 0; background: rgba(20,30,24,.42); display: flex; align-items: flex-end; }
.quantity-sheet { background: white; width: 100%; padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); }
.detail-actions-spacer { height: 120rpx; }
.detail-actions { position: fixed; z-index: 89; left: 0; right: 0; bottom: calc(96rpx + env(safe-area-inset-bottom)); display: flex; gap: 16rpx; padding: 12rpx 24rpx; background: #fff; border-top: 1rpx solid #e5eae5; }
.detail-actions .btn { flex: 1; min-height: 76rpx; margin: 0; }

/* 详情的库存批次为连续行；低频操作仍保留在更多和原有菜单。 */
.page { padding: 16px 16px calc(24px + env(safe-area-inset-bottom)); }
.hero-card { border: 0; box-shadow: none; }
.hero-header, .batch-header-row, .section-header { flex-wrap: wrap; gap: 8px; }
.med-name { font-size: 24px; font-weight: 400; min-width: 0; overflow-wrap: anywhere; }
.med-spec, .med-company { font-size: 13px; overflow-wrap: anywhere; }
.hero-edit-link, .section-toggle, .link-btn, .batch-action-link, .more-action-btn, .photo-action, .photo-delete, .note-delete { display: inline-flex; align-items: center; justify-content: center; min-width: 48px; min-height: 48px; height: auto; box-sizing: border-box; line-height: 1.4; }
.batch-card { margin: 0; padding: 16px 0; border: 0; border-top: 1px solid var(--med-inset, #f2f2f7); border-radius: 0; background: #fff; }
.batch-card .row { align-items: flex-start; flex-wrap: wrap; }
.batch-title { font-size: 15px; font-weight: 600; overflow-wrap: anywhere; }
.batch-line { font-size: 13px; overflow-wrap: anywhere; }
.batch-actions, .photo-actions, .more-actions-row, .quick-row, .split-actions { flex-wrap: wrap; }
.split-actions .btn, .detail-actions .btn { min-height: 48px; height: auto; line-height: 1.4; }
.quantity-sheet { box-sizing: border-box; max-height: 85vh; overflow-y: auto; border-radius: 16px 16px 0 0; }
.leaflet-photo-row { flex-wrap: wrap; }
.photo-meta { flex: 1 1 140px; }
.detail-footer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; background: #fff; border-top: 1px solid var(--med-line, #dcdce1); }
.detail-actions { position: static; padding: 8px 16px; border-top: 0; flex-wrap: wrap; }
/* em 随内容字号增大；动作和嵌入导航在同一容器内自然堆叠，不猜测导航高度。 */
.detail-actions-spacer { height: calc(8em + env(safe-area-inset-bottom)); }
.detail-actions .btn { min-width: 0; }
