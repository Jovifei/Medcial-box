.page {
  padding: 28rpx 30rpx 60rpx;
}

.med-name {
  font-size: 34rpx;
  font-weight: 700;
}

.med-spec {
  margin-top: 8rpx;
  color: #52685c;
  font-size: 24rpx;
}

.med-meta {
  margin-top: 12rpx;
  color: #778279;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 折叠区域与更多菜单（方案 §5） */
.section-header {
  align-items: flex-start;
}

.section-toggle {
  flex: none;
  margin-left: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #eef1ee;
  color: #52685c;
  font-size: 22rpx;
}

.quick-row {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.quick-action {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #cfdcd3;
  color: #3f7d5c;
  font-size: 27rpx;
}

.batch-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.batch-action-link {
  font-size: 24rpx;
  color: #3f7d5c;
}

.section-label {
  margin: 8rpx 0 16rpx 4rpx;
  font-size: 24rpx;
  color: #7c867e;
}

.menu-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e4ebe5;
}

.menu-title {
  font-size: 28rpx;
  color: #24382e;
}

.menu-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7c867e;
}

.menu-arrow {
  color: #a5b0a8;
  font-size: 32rpx;
}

/* 药盒封面：私有图片，下载到本地临时文件后展示 */
.cover-box {
  margin-top: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f2f5f2;
}

.cover-image {
  width: 100%;
  height: 320rpx;
  display: block;
}

.cover-placeholder {
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  color: #7c867e;
  font-size: 23rpx;
}

.link-btn {
  color: #3f7d5c;
  font-size: 23rpx;
  font-weight: 600;
}

.batch-card {
  margin-top: 14rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid #e9ede8;
  border-radius: 16rpx;
  background: #fbfcfb;
}

.batch-title {
  font-size: 25rpx;
  font-weight: 650;
}

.batch-line {
  margin-top: 8rpx;
  color: #52685c;
  font-size: 22rpx;
}

.batch-edit-hint {
  margin-top: 10rpx;
  color: #8a958d;
  font-size: 20rpx;
}

.batch-action {
  min-height: 72rpx;
  margin-top: 14rpx;
  font-size: 23rpx;
}

.split-panel {
  margin-top: 14rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid #c8dcca;
  border-radius: 16rpx;
  background: #f6fbf7;
}

.split-title { margin-bottom: 8rpx; font-size: 25rpx; font-weight: 700; }
.split-field { margin-top: 14rpx; margin-bottom: 0; }
.split-preview { margin-top: 12rpx; padding: 12rpx 14rpx; border-radius: 12rpx; background: #e8f2ea; color: #315e44; font-size: 23rpx; font-weight: 650; line-height: 1.5; }
.split-error { margin-top: 10rpx; color: #a45437; font-size: 22rpx; line-height: 1.5; }
.split-actions { display: flex; gap: 12rpx; margin-top: 16rpx; }
.split-actions .btn { flex: 1; min-height: 78rpx; margin-top: 0; padding: 14rpx; font-size: 23rpx; }

.opening-warning {
  color: #a45437;
  font-weight: 650;
}

.leaflet-badge {
  margin-top: 4rpx;
}

.leaflet-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
}

.leaflet-photo-section .section-title { margin-bottom: 0; }
.photo-count { color: #758278; font-size: 21rpx; }
.photo-upload { min-height: 78rpx; margin-top: 16rpx; font-size: 24rpx; }
.photo-status { margin-top: 10rpx; color: #3f7d5c; font-size: 21rpx; line-height: 1.55; }
.photo-error { margin-top: 10rpx; color: #a45437; font-size: 21rpx; line-height: 1.55; word-break: break-word; }
.photo-retry { margin-left: 8rpx; color: #3f7d5c; text-decoration: underline; }
.photo-loading,
.photo-empty { margin-top: 16rpx; }
.leaflet-photo-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #edf0ec; }
.photo-meta { min-width: 0; flex: 1; }
.photo-title { font-size: 23rpx; font-weight: 650; word-break: break-word; }
.photo-actions { display: flex; align-items: center; gap: 16rpx; flex: 0 0 auto; }
.photo-action { min-width: 74rpx; padding: 12rpx 16rpx; border: 1rpx solid #c8d4ca; border-radius: 999rpx; color: #3f7d5c; text-align: center; font-size: 21rpx; }
.photo-delete { padding: 12rpx 6rpx; color: #a45437; font-size: 21rpx; }

.note-card {
  margin-top: 14rpx;
  padding: 16rpx;
  border: 1rpx solid #e9ede8;
  border-radius: 14rpx;
  background: #fbfcfb;
}

.note-owner {
  color: #648274;
  font-size: 21rpx;
  font-weight: 650;
}

.note-delete {
  color: #a45437;
  font-size: 21rpx;
}

.note-content {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

/* —— 整理标签（R2-d）：与药箱首页同一套配色语义 —— */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 10rpx 0;
}

.medicine-tag {
  font-size: 22rpx;
  line-height: 1.5;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}

.medicine-tag.pop-adult {
  color: #1d5fd1;
  background: #e3edfb;
}

.medicine-tag.pop-child {
  color: #2f7d4f;
  background: #e2f2e8;
}

.medicine-tag.purpose {
  color: #6b3fa0;
  background: #efe7f9;
}

.quantity-mask { position: fixed; z-index: 100; inset: 0; background: rgba(20,30,24,.42); display: flex; align-items: flex-end; }
.quantity-sheet { background: white; width: 100%; padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); }