.page { padding-bottom: 60rpx; }
.home-header { padding: 18rpx 4rpx 24rpx; }
.title { font-size: 38rpx; font-weight: 700; }
.subtitle { margin-top: 8rpx; color: var(--med-secondary, #636366); font-size: 22rpx; line-height: 1.55; }
.error-card { border-color: var(--med-danger-line, #efc8c3); background: var(--med-danger-tint, #fff0ee); }
.empty-card { margin-top: 18rpx; padding: 34rpx 24rpx; border: 1rpx dashed var(--med-line, #dcdce1); border-radius: 20rpx; background: #fff; text-align: center; }
.audit-item { padding: 22rpx; }
.event-action { font-size: 26rpx; font-weight: 700; }
.event-actor { color: var(--med-secondary, #636366); font-size: 21rpx; }
.change-text { margin-top: 12rpx; color: var(--med-secondary, #636366); font-size: 22rpx; line-height: 1.6; overflow-wrap: anywhere; }
