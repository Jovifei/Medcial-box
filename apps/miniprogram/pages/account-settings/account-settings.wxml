<view class="page"><view class="card"><view class="section-title">账号设置</view><view class="hint">显示名用于家庭成员区分，不影响用药的人。</view><input class="input" value="{{nicknameDraft}}" maxlength="20" bindinput="onNicknameInput" placeholder="例如：爸爸" /><view class="btn btn-primary" bindtap="onSaveNickname">{{saving ? "保存中…" : "保存显示名"}}</view></view><view class="card"><view class="btn btn-danger" bindtap="onLogout">退出登录</view></view><view class="hint" wx:if="{{errorMessage}}">{{errorMessage}}</view></view>