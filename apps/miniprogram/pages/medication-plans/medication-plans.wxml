<view class="page">
  <view class="view-tabs">
    <view class="view-tab {{view === 'today' ? 'active' : ''}}" data-view="today" bindtap="onSwitchView">今日安排</view>
    <view class="view-tab {{view === 'all' ? 'active' : ''}}" data-view="all" bindtap="onSwitchView">全部计划</view>
  </view>

  <view class="card reminder-card">
    <view class="section-title">服药提醒</view>
    <view class="hint">{{reminderReason}}</view>
    <view class="reminder-actions" wx:if="{{reminderAvailable}}">
      <view class="action-btn primary" bindtap="onSubscribeDoseReminder">{{reminderSubscribing ? "等待授权…" : "订阅服药提醒"}}</view>
    </view>
    <view class="hint" wx:if="{{reminderStatusText !== ''}}">{{reminderStatusText}}</view>
    <view class="delivery-row" wx:for="{{deliveries}}" wx:key="date">
      <view class="delivery-when">{{item.date}} {{item.time}}</view>
      <view class="delivery-status {{item.status}}">{{item.statusLabel}}</view>
    </view>
  </view>

  <view class="card error-card" wx:if="{{errorMessage !== ''}}">
    <view class="section-title">暂时无法加载</view>
    <view class="hint">{{errorMessage}}</view>
    <view class="btn btn-ghost" bindtap="refresh">重新加载</view>
  </view>

  <block wx:if="{{view === 'today'}}">
    <view class="date-row">
      <view class="date-shift" data-delta="-1" bindtap="onShiftDate">‹ 前一天</view>
      <view class="date-current">{{date}}</view>
      <view class="date-shift" data-delta="1" bindtap="onShiftDate">后一天 ›</view>
    </view>

    <view class="filter-row" wx:if="{{profileOptions.length > 2}}">
      <view class="filter-chip {{profileFilter === item.id ? 'selected' : ''}}"
        wx:for="{{profileOptions}}" wx:key="id"
        data-id="{{item.id}}" bindtap="onProfileFilterChange">{{item.displayName}}</view>
    </view>

    <view class="card" wx:if="{{loading}}">
      <view class="hint">正在读取今日安排…</view>
    </view>
    <view class="card" wx:elif="{{visibleEntries.length === 0 && errorMessage === ''}}">
      <view class="section-title">{{profileFilter === '' ? '今天没有安排' : '该照护对象今天没有安排'}}</view>
      <view class="hint">{{hasAnyProfile ? '还没有用药计划；点击下方创建第一个计划。' : '创建计划前会先为“我自己”建立照护对象；孩子的计划可在授权后由家人代记。'}}</view>
    </view>

    <view wx:for="{{visibleEntries}}" wx:key="occurrenceId" class="card schedule-card">
      <view class="schedule-top">
        <view class="schedule-time">{{item.time}}</view>
        <view class="schedule-status {{item.statusClass}}">{{item.statusLabel}}</view>
      </view>
      <view class="schedule-profile">{{item.careProfileName}}</view>
      <view class="schedule-medicine">{{item.medicineName}}</view>
      <view class="schedule-dosage">剂量：{{item.dosageText}}</view>
      <view class="overdue-note" wx:if="{{item.overdue}}">已过时间未确认；不判定漏服，可补记或跳过。</view>
      <view class="schedule-actions" wx:if="{{item.status === 'pending'}}">
        <view class="action-btn primary {{confirmingId === item.occurrenceId ? 'busy' : ''}}" data-id="{{item.occurrenceId}}" data-action="taken" bindtap="onConfirmDose">{{confirmingId === item.occurrenceId ? '记录中…' : '已服用'}}</view>
        <view class="action-btn ghost {{confirmingId === item.occurrenceId ? 'busy' : ''}}" data-id="{{item.occurrenceId}}" data-action="skipped" bindtap="onConfirmDose">本次跳过</view>
      </view>
      <view class="schedule-actions" wx:else>
        <view class="action-btn ghost" data-id="{{item.occurrenceId}}" data-action="taken" bindtap="onConfirmDose">改为已服用</view>
        <view class="action-btn ghost" data-id="{{item.occurrenceId}}" data-action="skipped" bindtap="onConfirmDose">改为跳过</view>
        <view class="correct-hint">纠正会保留操作历史</view>
      </view>
    </view>
  </block>

  <block wx:if="{{view === 'all'}}">
    <view class="filter-row">
      <view class="filter-chip {{planStatusFilter === 'all' ? 'selected' : ''}}" data-status="all" bindtap="onPlanStatusChange">全部</view>
      <view class="filter-chip {{planStatusFilter === 'active' ? 'selected' : ''}}" data-status="active" bindtap="onPlanStatusChange">进行中</view>
      <view class="filter-chip {{planStatusFilter === 'paused' ? 'selected' : ''}}" data-status="paused" bindtap="onPlanStatusChange">已暂停</view>
      <view class="filter-chip {{planStatusFilter === 'ended' ? 'selected' : ''}}" data-status="ended" bindtap="onPlanStatusChange">已结束</view>
    </view>

    <view class="card" wx:if="{{loading}}">
      <view class="hint">正在读取计划…</view>
    </view>
    <view class="card" wx:elif="{{visiblePlans.length === 0 && errorMessage === ''}}">
      <view class="section-title">这个状态没有计划</view>
      <view class="hint">点击下方“＋创建计划”，为家人或自己安排固定时间的用药提醒；已结束的计划保留历史记录。</view>
    </view>
    <view wx:for="{{visiblePlans}}" wx:key="id" class="card plan-card" data-id="{{item.id}}" bindtap="onOpenPlanDetail">
      <view class="plan-top">
        <view class="plan-medicine">{{item.medicineName}}</view>
        <view class="plan-status {{item.status}}">{{item.statusLabel}}</view>
      </view>
      <view class="plan-profile">照护对象：{{item.careProfileName}}</view>
      <view class="plan-detail">剂量：{{item.dosageText}} · {{item.weekdayText}} {{item.slotText}}</view>
      <view class="plan-range">{{item.rangeText}}</view>
      <view class="plan-actions">
        <view class="action-btn ghost" wx:if="{{item.status === 'active'}}" data-id="{{item.id}}" data-action="pause" catchtap="onTogglePlanStatus">暂停</view>
        <view class="action-btn primary" wx:if="{{item.status === 'paused'}}" data-id="{{item.id}}" data-action="resume" catchtap="onTogglePlanStatus">恢复</view>
        <view class="plan-detail-link" wx:if="{{item.status === 'ended'}}">点击查看历史记录</view>
      </view>
    </view>
  </block>

  <view class="safety-note">服药记录只用于家庭提醒整理，不自动扣减库存，也不替代医嘱。</view>
  <view class="bottom-spacer"></view>
  <view class="floating-add" bindtap="onOpenCreateForm">＋ 创建计划</view>
</view>
