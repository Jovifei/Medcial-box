.page {
  padding: 32rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
  background: #f5f7f4;
  min-height: 100vh;
  box-sizing: border-box;
}

/* —— 视图切换 —— */

.view-tabs {
  display: flex;
  margin-bottom: 24rpx;
  padding: 6rpx;
  border-radius: 32rpx;
  background: #e8efe9;
}

.view-tab {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 28rpx;
  color: #52685c;
  font-size: 27rpx;
}

.view-tab.active {
  background: #ffffff;
  color: #315f46;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(63, 125, 92, 0.12);
}

/* —— 通用卡片 —— */

.card {
  background: #ffffff;
  border-radius: 32rpx;
  border: 1rpx solid #e4ebe5;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.error-card {
  border-color: #eccfcf;
  background: #fdf5f5;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #24382e;
  margin-bottom: 16rpx;
}

.hint {
  font-size: 25rpx;
  color: #596a60;
  line-height: 1.6;
}

/* —— 日期切换 —— */

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.date-shift {
  min-width: 140rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e1e7e1;
  color: #3f7d5c;
  font-size: 24rpx;
}

.date-current {
  font-size: 30rpx;
  font-weight: 600;
  color: #24382e;
}

/* —— 今日安排 —— */

.schedule-card {
  padding-bottom: 28rpx;
}

.schedule-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.schedule-time {
  font-size: 36rpx;
  font-weight: 700;
  color: #24382e;
}

.schedule-status {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.schedule-status.pending {
  color: #8a6a1f;
  background: #fbf1da;
}

.schedule-status.taken {
  color: #2f7d4f;
  background: #e2f2e8;
}

.schedule-status.skipped {
  color: #596a60;
  background: #eef1ee;
}

.schedule-profile {
  font-size: 23rpx;
  color: #7c867e;
}

.schedule-medicine {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #24382e;
}

.schedule-dosage {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #52685c;
}

.overdue-note {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #fbf1da;
  color: #8a6a1f;
  font-size: 23rpx;
  line-height: 1.5;
}

.schedule-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
}

.action-btn {
  flex: 1;
  min-width: 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  font-size: 28rpx;
}

.action-btn.primary {
  background: #3f7d5c;
  color: #ffffff;
}

.action-btn.ghost {
  background: #ffffff;
  border: 1rpx solid #cfdcd3;
  color: #3f7d5c;
}

.action-btn.busy {
  opacity: 0.55;
}

.correct-hint {
  flex: none;
  font-size: 21rpx;
  color: #7c867e;
}

/* —— 服药提醒 —— */

.reminder-card {
  padding-bottom: 28rpx;
}

.reminder-actions {
  margin-top: 18rpx;
}

.delivery-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #eef1ee;
}

.delivery-when {
  font-size: 24rpx;
  color: #52685c;
}

.delivery-status {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: #596a60;
  background: #eef1ee;
}

.delivery-status.sent {
  color: #2f7d4f;
  background: #e2f2e8;
}

.delivery-status.failed {
  color: #b4544f;
  background: #fdf5f5;
}

.delivery-status.cancelled,
.delivery-status.blocked {
  color: #7c867e;
  background: #f4f6f4;
}

/* —— 筛选条 —— */

.filter-row {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 12rpx;
  padding: 14rpx 22rpx;
  border: 1rpx solid #e1e7e1;
  border-radius: 999rpx;
  background: #ffffff;
  color: #52685c;
  font-size: 23rpx;
}

.filter-chip.selected {
  border-color: #3f7d5c;
  background: #e9f2ec;
  color: #315f46;
}

/* —— 全部计划 —— */

.plan-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.plan-medicine {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #24382e;
}

.plan-status {
  flex: none;
  margin-left: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.plan-status.active {
  color: #2f7d4f;
  background: #e2f2e8;
}

.plan-status.paused {
  color: #596a60;
  background: #eef1ee;
}

.plan-status.ended {
  color: #7c867e;
  background: #f4f6f4;
}

.plan-detail-link {
  font-size: 23rpx;
  color: #7c867e;
}

.plan-profile {
  font-size: 23rpx;
  color: #7c867e;
}

.plan-detail {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #52685c;
  line-height: 1.5;
}

.plan-range {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #7c867e;
}

.plan-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

/* —— 底部说明与悬浮按钮 —— */

.safety-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7c867e;
  line-height: 1.6;
  text-align: center;
}

.bottom-spacer {
  height: 40rpx;
}

.floating-add {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 32rpx;
  background: #3f7d5c;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(63, 125, 92, 0.28);
}

/* —— 创建计划弹层 —— */

.form-layer {
  position: fixed;
  inset: 0;
  z-index: 50;
}

.form-mask {
  position: absolute;
  inset: 0;
  background: rgba(20, 32, 25, 0.42);
}

.form-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 88vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #f5f7f4;
  overflow-y: auto;
}

.sheet-handle {
  width: 88rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: #d5ded7;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #24382e;
  text-align: center;
}

.sheet-hint {
  margin: 10rpx 0 24rpx;
  text-align: center;
}

.field {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e4ebe5;
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #52685c;
}

.row-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-line .field-label {
  margin-bottom: 0;
}

.input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #f7f9f7;
  border: 1rpx solid #e1e7e1;
  font-size: 27rpx;
  color: #24382e;
}

.picker-box {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #f7f9f7;
  border: 1rpx solid #e1e7e1;
  font-size: 27rpx;
  color: #24382e;
}

.time-add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time-input {
  flex: 1;
  min-width: 0;
}

.time-add-row .action-btn {
  flex: none;
  min-width: 160rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.slot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.slot-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #e9f2ec;
  color: #315f46;
  font-size: 24rpx;
}

.slot-remove {
  font-size: 26rpx;
  color: #7c867e;
}

.weekday-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.weekday-chip {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #f7f9f7;
  border: 1rpx solid #e1e7e1;
  color: #52685c;
  font-size: 25rpx;
}

.weekday-chip.on {
  background: #3f7d5c;
  border-color: #3f7d5c;
  color: #ffffff;
}

/* —— 按钮 —— */

.btn {
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-bottom: 16rpx;
}

.btn-primary {
  background: #3f7d5c;
  color: #ffffff;
}

.btn-ghost {
  background: #ffffff;
  border: 1rpx solid #cfdcd3;
  color: #52685c;
}

.btn.disabled {
  opacity: 0.55;
}
