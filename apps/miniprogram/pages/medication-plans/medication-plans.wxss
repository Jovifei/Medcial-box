.page {
  padding: 24rpx 32rpx 48rpx;
  background: #f5f7f4;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  border: 2rpx solid #e4ebe5;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #24382e;
  margin-bottom: 16rpx;
}

.hint {
  font-size: 28rpx;
  color: #596a60;
  line-height: 1.6;
}

.btn {
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.btn-primary {
  background: #3f7d5c;
  color: #ffffff;
}
