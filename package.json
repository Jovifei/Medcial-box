{
  "name": "jovi-home-medicine-cabinet",
  "version": "0.1.0",
  "private": true,
  "description": "A shared WeChat mini program for a household medicine cabinet.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contracts",
    "apps/miniprogram",
    "apps/api"
  ],
  "scripts": {
    "lint": "eslint apps packages scripts --ext .ts,.mjs --max-warnings=0 && node scripts/check-json.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:tooling",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:integration": "npm run build --workspace @home-medicine/api && node scripts/run-integration.mjs",
    "prepare:mini:qa": "node scripts/prepare-miniprogram-qa.mjs",
    "test:mini:qa": "node --test scripts/miniprogram-qa.test.mjs",
    "prepare:mini": "node scripts/prepare-miniprogram.mjs",
    "check:staging": "node scripts/check-staging.mjs",
    "setup:staging": "node scripts/init-staging-config.mjs",
    "check:miniprogram": "node scripts/check-miniprogram-compile.mjs",
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace @home-medicine/api",
    "dev:local-trials": "node scripts/start-local-trials.mjs",
    "check:miniprogram:package": "node scripts/check-miniprogram-package.mjs",
    "test:miniprogram:runtime": "node scripts/test-jf-wechat-runtime.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/wechat-miniprogram": "^3.4.10",
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.70.1",
    "typescript": "^5.9.3"
  }
}
